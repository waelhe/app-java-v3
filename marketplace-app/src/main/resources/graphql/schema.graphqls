type Query {
    service(id: ID!): Service
    # The bounded collection contract (GraphQL target design Phase 1): the
    # unbounded demo field `services: [Service!]!` (Pageable.unpaged() under
    # it) is REPLACED, not paralleled — the consumer inventory measured zero
    # contracted consumers (the repo's own tests are the only callers; the
    # Android client is REST-only), which is the design plan §6 condition for
    # direct replacement. The field is the official Spring for GraphQL relay
    # Connection path: ServiceConnection/ServiceEdge/PageInfo are generated
    # at startup by Boot's ConnectionTypeDefinitionConfigurer, the returned
    # Spring Data Page is adapted by the auto-registered SliceConnectionAdapter
    # (Page is-a Slice — verified against spring-boot-graphql 4.1.1), and
    # `after` cursors are base64 ScrollPosition offsets produced by that same
    # adapter — decoded back by the auto-registered Subrange argument resolver.
    # `first` defaults to the server's default page size (bounded, hard-capped);
    # forward-only (last/before deliberately absent) with deterministic
    # server-side ordering.
    services(first: Int = 20, after: String): ServiceConnection!
}

type Mutation {
    createService(input: ServiceInput!): Service!
}

type Service {
    id: ID!
    name: String!
    description: String
    category: String!
    price: Float!
    currency: String!
    status: ServiceStatus!
}

enum ServiceStatus {
    ACTIVE
    INACTIVE
}

# Input speaks integer cents — the domain money language of every write
# surface (REST CreateListingRequest.priceCents, V2 price_cents >= 0,
# BookingInfo). spring-graphql's GraphQlArgumentBinder binds input keys to
# constructor parameter names BY NAME, so the field name must equal the
# ServiceInput.priceCents record component. (The read side keeps display
# units: Service.price — major units via ServiceMapper.) Int is a signed
# 32-bit scalar per the GraphQL spec — the explicit shared ceiling
# 2,147,483,647 is declared in ServiceInput via @Max.
input ServiceInput {
    name: String!
    description: String
    category: String!
    priceCents: Int!
}
