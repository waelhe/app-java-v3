# =====================================================================
# The attribute-value mutation roots — the catalog owner's CHOICE-
# attribute option-value ADMIN write use case over the EXISTING
# catalog_attribute_options table (no new migration). Signatures are
# the pinned 3.23.43 shapes (attributeValueDelete/attributeValueUpdate
# carry the externalReference argument — no external-ID column exists
# on this platform, so a non-null value answers the classified
# validation error, never a silent no-op).
# =====================================================================
extend type Mutation {
    """Creates a value for an attribute."""
    attributeValueCreate(
        """Attribute to which value will be assigned (the typed global ID of the CHOICE attribute)."""
        attribute: ID!

        """Fields required to create an attribute value."""
        input: AttributeValueCreateInput!
    ): AttributeValueCreate

    """Deletes a value of an attribute."""
    attributeValueDelete(
        """
        External ID of an attribute value to delete. No external-ID
        column exists on this platform (the recorded divergence); a
        non-null value answers the classified validation error.
        """
        externalReference: String

        """ID of an attribute value to delete."""
        id: ID
    ): AttributeValueDelete

    """Updates value of an attribute."""
    attributeValueUpdate(
        """
        External ID of an attribute value to update. No external-ID
        column exists on this platform; a non-null value answers the
        classified validation error.
        """
        externalReference: String

        """ID of an attribute value to update."""
        id: ID

        """Fields required to update an attribute value."""
        input: AttributeValueUpdateInput!
    ): AttributeValueUpdate

    """Deletes values of attributes."""
    attributeValueBulkDelete(
        """List of attribute value IDs to delete."""
        ids: [ID!]!
    ): AttributeValueBulkDelete
}

# =====================================================================
# The bounded AttributeValueCreateInput — the pinned Saleor input's
# OWNED field set: name (the bilingual row's name_en — String! in the
# pinned shape) PLUS the platform-extension slug carrier the row's own
# NOT NULL code policy requires and the Saleor closure cannot declare
# (the "platform-only fields as extensions" policy the VoucherInput's
# discount facts established — Saleor derives the value slug from the
# name; this platform's row owns an explicit stable code). The
# unowned members (value — no swatch carrier, the deprecated
# richText/plainText, fileUrl/contentType — no file owner,
# externalReference — no column) stay undeclared — recorded
# divergences, never faked. The append position is the owner's own
# max+1 derivation — never a client-supplied fact.
# =====================================================================
input AttributeValueCreateInput {
    """Name of a value displayed in the interface (the bilingual row's name_en)."""
    name: String!

    """
    PLATFORM EXTENSION (the row's NOT NULL code policy — no Saleor
    carrier in the declarable closure): the option's stable public
    code, a lowercase latin slug unique within the owning attribute.
    """
    slug: String
}

# =====================================================================
# The bounded AttributeValueUpdateInput — the pinned Saleor input's
# OWNED field set: name (display metadata; the row's code is immutable
# by the entity's own identity law — a different slug answers the
# classified INVALID payload error, never a silent drop) plus the same
# platform-extension slug carrier for the idempotent re-send. The
# unowned members stay undeclared — recorded divergences, never faked.
# =====================================================================
input AttributeValueUpdateInput {
    """Name of a value displayed in the interface."""
    name: String

    """The row's stable public code (the idempotent re-send carrier)."""
    slug: String
}

# =====================================================================
# The bounded AttributeValue wire type — the pinned Saleor type's
# OWNED field set only: the typed global ID, the rendered primary
# display name, and the row's immutable public code (the Saleor slug
# mapping). The unowned members (value — no swatch carrier,
# translation — no translation owner) stay undeclared — recorded
# divergences, never faked.
# =====================================================================
type AttributeValue {
    """The ID of the attribute value — typed global ID (opaque, never a raw UUID)."""
    id: ID!

    """Name of a value displayed in the interface (the rendered primary display name)."""
    name: String

    """Internal representation of a value (the row's immutable public code, unique per attribute)."""
    slug: String
}

type AttributeValueCreate {
    """The updated attribute (the owning CHOICE attribute's projection)."""
    attribute: Attribute
    errors: [AttributeError!]!
    attributeValue: AttributeValue
}

type AttributeValueUpdate {
    """The updated attribute (the owning CHOICE attribute's projection)."""
    attribute: Attribute
    errors: [AttributeError!]!
    attributeValue: AttributeValue
}

type AttributeValueDelete {
    """The updated attribute (the owning CHOICE attribute's projection)."""
    attribute: Attribute
    errors: [AttributeError!]!
    attributeValue: AttributeValue
}

type AttributeValueBulkDelete {
    """Returns how many objects were affected."""
    count: Int!
    errors: [AttributeError!]!
}

# =====================================================================
# The translation mutation roots — the catalog registries' bilingual
# translation ADMIN write use case (the MANAGE_TRANSLATIONS family).
# The platform's own two-language law is the honest bounded mapping of
# Saleor's per-locale translation rows: the bilingual columns
# (name_en/name_ar) ARE the platform's translation storage — AR
# addresses the name_ar dimension, EN the name_en dimension (the
# central schema's own two-member LanguageCodeEnum). Signatures are
# the pinned 3.23.43 shapes for the owned field set; the unowned
# input members (the JSONString description family, the SEO fields,
# the richText/plainText pair) have no owning capabilities on this
# surface and stay undeclared — recorded divergences, never faked.
# =====================================================================
extend type Mutation {
    """Updates a category's translation for the addressed language dimension."""
    categoryTranslate(
        """Category ID or CategoryTranslatableContent ID."""
        id: ID!

        """Fields required to update category translations (the bounded owned set: the display name)."""
        input: TranslationInput!

        """Translation language code — the platform's own AR/EN bilingual closure."""
        languageCode: LanguageCodeEnum!
    ): CategoryTranslate

    """Updates an attribute's translation for the addressed language dimension."""
    attributeTranslate(
        """Attribute ID or AttributeTranslatableContent ID."""
        id: ID!

        """Fields required to update attribute translations (the bounded owned set: the display name)."""
        input: NameTranslationInput!

        """Translation language code — the platform's own AR/EN bilingual closure."""
        languageCode: LanguageCodeEnum!
    ): AttributeTranslate

    """Updates an attribute value's translation for the addressed language dimension."""
    attributeValueTranslate(
        """AttributeValue ID or AttributeValueTranslatableContent ID."""
        id: ID!

        """
        Fields required to update attribute value translations (the
        bounded owned set: the display name; the richText/plainText
        pair stays undeclared — no owning columns).
        """
        input: AttributeValueTranslationInput!

        """Translation language code — the platform's own AR/EN bilingual closure."""
        languageCode: LanguageCodeEnum!
    ): AttributeValueTranslate
}

# =====================================================================
# The bounded TranslationInput — the pinned Saleor input's OWNED field
# set only: the display name (the registry's bilingual column family).
# The unowned members (description/fullDescription as JSONString,
# slug/seoTitle/seoDescription) have no owning capabilities on this
# surface and stay undeclared — recorded divergences, never faked.
# =====================================================================
input TranslationInput {
    """The addressed language's display name (null preserves the column)."""
    name: String
}

input NameTranslationInput {
    """The addressed language's display name (null preserves the column)."""
    name: String
}

input AttributeValueTranslationInput {
    """The addressed language's display name (null preserves the column)."""
    name: String
}

type TranslationError {
    """Name of a field that caused the error (null = not field-associated)."""
    field: String

    """The error message."""
    message: String

    """The error code."""
    code: TranslationErrorCode!
}

enum TranslationErrorCode {
    GRAPHQL_ERROR
    INVALID
    NOT_FOUND
    REQUIRED
    UNIQUE
}

type CategoryTranslate {
    errors: [TranslationError!]!
    category: Category
}

type AttributeTranslate {
    errors: [TranslationError!]!
    attribute: Attribute
}

type AttributeValueTranslate {
    errors: [TranslationError!]!
    attributeValue: AttributeValue
}

# =====================================================================
# The product-type attribute schema mutation roots — the assignment
# registry's ADMIN write use case over the EXISTING
# product_type_attribute_assignments table (no new migration). The
# pinned input's type (PRODUCT/VARIANT) + variantSelection pair maps
# onto the platform's own three-scope model (PRODUCT / VARIANT /
# VARIANT_SELECTION — a VARIANT_SELECTION assignment is required for
# every variant and rides the CHOICE value shape with the two-option
# floor, the module's own invariants). The append position is the
# owner's own max+1 derivation; the reorder resolves the pinned
# relative moves with the compacted 1..n re-derivation.
# =====================================================================
extend type Mutation {
    """Assigns attributes to a product type's schema."""
    productAttributeAssign(
        """The operations to perform (the attribute reference, the type member and the variant-selection flag)."""
        operations: [ProductAttributeAssignInput!]!

        """ID of the product type to assign the attributes into (typed global ID of the ProductType root's type)."""
        productTypeId: ID!
    ): ProductAttributeAssign

    """Updates the assignments' variant-selection membership (the VARIANT↔VARIANT_SELECTION scope move)."""
    productAttributeAssignmentUpdate(
        """The operations to perform (the attribute reference and the new variant-selection flag)."""
        operations: [ProductAttributeAssignmentUpdateInput!]!

        """ID of the product type whose schema is amended (typed global ID of the ProductType root's type)."""
        productTypeId: ID!
    ): ProductAttributeAssignmentUpdate

    """Unassigns attributes from a product type's schema."""
    productAttributeUnassign(
        """The IDs of the attributes to unassign (typed global IDs of the Attribute root's type)."""
        attributeIds: [ID!]!

        """ID of the product type from which the attributes should be unassigned."""
        productTypeId: ID!
    ): ProductAttributeUnassign

    """Reorders the assigned attributes of one attribute-type bucket of a product type."""
    productTypeReorderAttributes(
        """The list of attribute reordering operations (the relative moves)."""
        moves: [ReorderInput!]!

        """ID of a product type."""
        productTypeId: ID!

        """The attribute type bucket to reorder (PRODUCT or VARIANT — the VARIANT bucket holds both VARIANT-family scopes)."""
        type: ProductAttributeType!
    ): ProductTypeReorderAttributes

    """Reorders an attribute's registered option values."""
    attributeReorderValues(
        """ID of an attribute (typed global ID of the Attribute root's type)."""
        attributeId: ID!

        """The list of reordering operations for the attribute's values (the relative moves)."""
        moves: [ReorderInput!]!
    ): AttributeReorderValues
}

input ProductAttributeAssignInput {
    """The ID of the attribute to assign (typed global ID of the Attribute root's type)."""
    id: ID!

    """The attribute type to be assigned as (the platform's own scope mapping)."""
    type: ProductAttributeType!

    """
    Whether the attribute is allowed in variant selection (the
    platform's VARIANT_SELECTION scope — required for every variant,
    CHOICE value shape with at least two options).
    """
    variantSelection: Boolean
}

input ProductAttributeAssignmentUpdateInput {
    """The ID of the assigned attribute (typed global ID of the Attribute root's type)."""
    id: ID!

    """
    The new variant-selection membership (the VARIANT↔VARIANT_
    SELECTION scope move; a PRODUCT-typed assignment's membership is
    immutable).
    """
    variantSelection: Boolean!
}

enum ProductAttributeType {
    PRODUCT
    VARIANT
}

input ReorderInput {
    """The ID of the item to move (the context's own typed global ID)."""
    id: ID!

    """
    The new relative sorting position of the item (from -inf to
    +inf). 1 moves the item one position forward, -1 moves the item
    one position backward, 0 leaves the item unchanged.
    """
    sortOrder: Int
}

type ProductAttributeAssign {
    errors: [ProductError!]!
    productType: ProductType
}

type ProductAttributeAssignmentUpdate {
    errors: [ProductError!]!
    productType: ProductType
}

type ProductAttributeUnassign {
    errors: [ProductError!]!
    productType: ProductType
}

type ProductTypeReorderAttributes {
    errors: [ProductError!]!
    productType: ProductType
}

type AttributeReorderValues {
    errors: [AttributeError!]!
    attribute: Attribute
}

# =====================================================================
# The bulk mutation roots — the registries' batch write use cases over
# the SAME owning single-item ladders (the agent-2 follow-on packet).
# The whole batch rides ONE transaction; the pinned error policy's own
# semantics answer (REJECT_EVERYTHING — the default — rolls the whole
# batch back when any item is refused; IGNORE_FAILED/
# REJECT_FAILED_ROWS persist the passing items at the per-row
# granularity the flat create carries). The per-item outcomes render
# as Saleor's per-item results entries with the path pointer
# (item index + the domain error's field); the top-level errors field
# stays the bounded closure's own empty list (no call-level failure
# mode exists in this closure — per-item domain errors answer in
# their own results entries).
# =====================================================================
extend type Mutation {
    """Creates attributes."""
    attributeBulkCreate(
        """Input list of attributes to create (the bounded owned field set per item)."""
        attributes: [AttributeCreateInput!]!

        """Policies of error handling. DEFAULT: REJECT_EVERYTHING"""
        errorPolicy: ErrorPolicyEnum
    ): AttributeBulkCreate

    """Updates attributes."""
    attributeBulkUpdate(
        """Input list of attributes to update (the pinned id + bounded fields per item)."""
        attributes: [AttributeBulkUpdateInput!]!

        """Policies of error handling. DEFAULT: REJECT_EVERYTHING"""
        errorPolicy: ErrorPolicyEnum
    ): AttributeBulkUpdate

    """Creates products."""
    productBulkCreate(
        """Policies of error handling. DEFAULT: REJECT_EVERYTHING"""
        errorPolicy: ErrorPolicyEnum

        """
        Input list of products to create (the bounded owned field set
        per item — the pinned REQUIRED productType reference plus the
        platform-extension carriers the row's NOT NULL policy
        requires).
        """
        products: [ProductBulkCreateInput!]!
    ): ProductBulkCreate
}

enum ErrorPolicyEnum {
    IGNORE_FAILED
    REJECT_EVERYTHING
    REJECT_FAILED_ROWS
}

input AttributeBulkUpdateInput {
    """ID of the attribute to update (typed global ID of the Attribute root's type)."""
    id: ID!

    """Fields required to update the attribute (the bounded owned movable set: name and slug)."""
    fields: AttributeUpdateInput!
}

# =====================================================================
# The bounded ProductBulkCreateInput — the SAME owned field set the
# single-item ProductCreateInput carries (the pinned input's REQUIRED
# productType reference plus the platform-extension carriers). The
# unowned members (attributes/category/collections/chargeTaxes/
# taxClass/taxCode/seo/weight/rating/metadata/privateMetadata/
# externalReference/media/channelListings/variants) have no owning
# capabilities on this surface and stay undeclared — recorded
# divergences, never faked.
# =====================================================================
input ProductBulkCreateInput {
    """Product name (the entity's own display title)."""
    name: String

    """Product description (plain text on this surface)."""
    description: String

    """
    ID of the product's reusable goods schema (typed global ID of the
    ProductType root's type — REQUIRED per the pinned input's own
    contract).
    """
    productType: ID!

    """
    PLATFORM EXTENSION (the row's NOT NULL category reference): the
    stable code of the store-categories dictionary row the product
    belongs to.
    """
    storeCategoryCode: String

    """
    PLATFORM EXTENSION (the row's NOT NULL price policy): the
    authoritative unit price in minor units (a non-negative amount).
    """
    priceMinor: Int

    """PLATFORM EXTENSION: the price's ISO-4217 currency code."""
    currency: String
}

type AttributeBulkCreate {
    count: Int!
    results: [AttributeBulkCreateResult!]!
    errors: [AttributeBulkCreateError!]!
}

type AttributeBulkCreateResult {
    attribute: Attribute
    errors: [AttributeBulkCreateError!]
}

type AttributeBulkCreateError {
    path: String
    message: String
    code: AttributeBulkCreateErrorCode!
}

enum AttributeBulkCreateErrorCode {
    ALREADY_EXISTS
    BLANK
    GRAPHQL_ERROR
    INVALID
    NOT_FOUND
    REQUIRED
    UNIQUE
    DUPLICATED_INPUT_ITEM
    MAX_LENGTH
