# =====================================================================
# The product-variant bulk mutation roots — the variant registry's
# batch write use cases over the SAME owning single-item ladder (the
# agent-2 follow-on packet). The same one-transaction/policy semantics
# the other bulk families ride.
# =====================================================================
extend type Mutation {
    """Creates product variants under one owning product."""
    productVariantBulkCreate(
        """Policies of error handling. DEFAULT: REJECT_EVERYTHING"""
        errorPolicy: ErrorPolicyEnum

        """ID of the owning product every variant registers under (typed global ID of the Product root's type)."""
        product: ID!

        """Input list of variants to create (the bounded owned field set per item)."""
        variants: [ProductVariantBulkCreateInput!]!
    ): ProductVariantBulkCreate

    """Updates product variants."""
    productVariantBulkUpdate(
        """Policies of error handling. DEFAULT: REJECT_EVERYTHING"""
        errorPolicy: ErrorPolicyEnum

        """
        ID of the owning product (the pinned root's own owning context;
        the rows address by their own ids — typed global ID of the
        Product root's type).
        """
        product: ID!

        """Input list of variants to update (the pinned id + bounded fields per item)."""
        variants: [ProductVariantBulkUpdateInput!]!
    ): ProductVariantBulkUpdate
}

# =====================================================================
# The bounded ProductVariantBulkCreateInput — the SAME owned field set
# the single-item ProductVariantCreateInput carries minus the product
# reference (the pinned root's own product argument owns it). The
# unowned members (attributes/stocks/trackInventory/weight/preorder/
# quantityLimitPerCustomer/metadata/privateMetadata/externalReference/
# channelListings) have no owning capabilities on this surface and stay
# undeclared — recorded divergences, never faked.
