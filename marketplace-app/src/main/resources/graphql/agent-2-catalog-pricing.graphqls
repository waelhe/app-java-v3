# =====================================================================
extend type Mutation {
    """Creates a new voucher."""
    voucherCreate(
        """Fields required to create a voucher."""
        input: VoucherInput!
    ): VoucherCreate

    """Deletes a voucher."""
    voucherDelete(
        """
        External ID of a voucher to delete. No external-ID column exists
        on this platform; a non-null value answers the classified
        validation error.
        """
        externalReference: String

        """ID of a voucher to delete."""
        id: ID
    ): VoucherDelete

    """Deletes vouchers."""
    voucherBulkDelete(
        """List of voucher IDs to delete."""
        ids: [ID!]!
    ): VoucherBulkDelete

    """Updates a voucher."""
    voucherUpdate(
        """
        External ID of a voucher to update. No external-ID column exists
        on this platform; a non-null value answers the classified
