# =====================================================================
# Agent 2 — Catalog / Pricing / Discounts (P2 + P3) bounded SDL
#
# The agent-2 packet's own schema fragment (the campaign's SDL
# isolation rule): every root below carries the EXACT Saleor 3.23.43
# pinned signature (repository saleor/saleor, ref 3.23.43,
# saleor/graphql/schema.graphql, blob b8fa0dd809081f76dc2834bb5c286561e
# 5783276) for the arguments the platform's house no-new-scalar SDL can
# declare. Saleor-only directives (@doc/@webhookEventsInfo) and fields
# whose scalar owners do not exist on this surface (Upload, JSONString,
# JSON, PositiveDecimal, DateTime) stay undeclared until an owning
# capability exists — the same bounded-closure discipline the read
# roots' SDL established; every declared-but-unowned ARGUMENT answers
# the explicit classified error when sent, never a silent no-op.
#
# Bounded executable slices (this packet):
#   categoryCreate / categoryUpdate / categoryDelete /
#   categoryBulkDelete — the registry's ADMIN write use case over the
#   EXISTING categories table (no new migration).
#   productTypeCreate / productTypeUpdate / productTypeDelete /
#   productTypeBulkDelete — the goods-schema collection's ADMIN write
#   use case over the EXISTING product_types table (no new migration).
#   voucherCreate / voucherUpdate / voucherDelete / voucherBulkDelete —
#   the pricing owner's voucher-policy ADMIN write use case over the
#   EXISTING vouchers table (no new migration).
#   productCreate / productUpdate / productDelete / productBulkDelete —
#   the catalog owner's provider-scoped product write use case over the
#   EXISTING products table (no new migration).
#   attributeCreate / attributeUpdate / attributeDelete /
#   attributeBulkDelete — the typed attribute collection's ADMIN write
#   use case over the EXISTING catalog_attribute_definitions table
#   (no new migration).
#   attributeValueCreate / attributeValueUpdate / attributeValueDelete /
#   attributeValueBulkDelete — the CHOICE attribute's option values'
#   ADMIN write use case over the EXISTING catalog_attribute_options
#   table (no new migration).
#
# Recorded owner decision (NOT a fake no-op): the Saleor 3.23
# promotionCreate/Update/Delete model is the RULES-engine promotion
# system (PromotionCreateInput.type/rules with cataloguePredicate
# rewards) — the platform's V223 promotion row is the classic discount
# policy (discount_type/discount_value/min_spend) with NO rules
# storage. promotionCreate cannot execute without either fabricating
# the row's NOT NULL discount facts (dishonest) or building the rules
# engine (its own multi-packet project): the roots stay BLOCKED_BY_
# DECISION with this evidence in the handoff.
# =====================================================================

extend type Mutation {
    """Creates a new category."""
    categoryCreate(
        """Fields required to create a category."""
        input: CategoryInput!

        """
        ID of the parent category. The platform registry is FLAT (no
        nesting tree owner — the registered read-root divergence); a
        non-null value answers the classified validation error.
        """
        parent: ID
    ): CategoryCreate

    """Deletes a category."""
    categoryDelete(
        """
        External ID of a category to delete. No external-ID column
        exists on this platform (the registered divergence); a non-null
        value answers the classified validation error.
        """
        externalReference: String

        """ID of a category to delete."""
        id: ID
    ): CategoryDelete

    """Deletes categories."""
    categoryBulkDelete(
        """List of category IDs to delete."""
        ids: [ID!]!
    ): CategoryBulkDelete

    """Updates a category."""
    categoryUpdate(
        """
        External ID of a category to update. No external-ID column
        exists on this platform; a non-null value answers the classified
        validation error.
        """
        externalReference: String

        """ID of a category to update."""
        id: ID

        """Fields required to update a category."""
        input: CategoryInput!
    ): CategoryUpdate
}

# =====================================================================
# The bounded CategoryInput — the pinned Saleor input's OWNED field set
# only: name and slug (the registry's name_en / code columns). The
# unowned members (description/fullDescription as JSONString, seo,
# backgroundImage as Upload, backgroundImageAlt, externalReference,
# metadata, privateMetadata) have neither scalar owners nor owning
# capabilities on this surface and stay undeclared — recorded
# divergences, never faked.
# =====================================================================
input CategoryInput {
    """Category name — the registry's primary display name (name_en)."""
    name: String

    """Category slug — the registry's stable public code."""
    slug: String
}

type CategoryCreate {
    errors: [ProductError!]!
    category: Category
}

type CategoryUpdate {
    errors: [ProductError!]!
    category: Category
}

type CategoryDelete {
    errors: [ProductError!]!
    category: Category
}

type CategoryBulkDelete {
    """Returns how many objects were affected."""
    count: Int!
    errors: [ProductError!]!
}

type ProductError {
    """
    Name of a field that caused the error. A value of `null` indicates
    that the error isn't associated with a particular field.
    """
    field: String

    """The error message."""
    message: String

    """The error code."""
    code: ProductErrorCode!
}

# The pinned Saleor 3.23.43 ProductErrorCode membership set — the
# Products-domain mutation payload error vocabulary (declared whole:
# enum members are wire vocabulary, not owned capabilities; this
# surface currently answers REQUIRED/INVALID/NOT_FOUND/ALREADY_EXISTS).
enum ProductErrorCode {
    ALREADY_EXISTS
    ATTRIBUTE_ALREADY_ASSIGNED
    ATTRIBUTE_CANNOT_BE_ASSIGNED
    ATTRIBUTE_VARIANTS_DISABLED
    MEDIA_ALREADY_ASSIGNED
    DUPLICATED_INPUT_ITEM
    GRAPHQL_ERROR
    INVALID
    INVALID_PRICE
    PRODUCT_WITHOUT_CATEGORY
    NOT_PRODUCTS_IMAGE
    NOT_PRODUCTS_VARIANT
    NOT_FOUND
    REQUIRED
    UNIQUE
    CANNOT_MANAGE_PRODUCT_WITHOUT_VARIANT
    PRODUCT_NOT_ASSIGNED_TO_CHANNEL
    UNSUPPORTED_MEDIA_PROVIDER
    PREORDER_VARIANT_CANNOT_BE_DEACTIVATED
    INVALID_FILE_TYPE
    UNSUPPORTED_MIME_TYPE
    FILE_SIZE_LIMIT_EXCEEDED
}

# =====================================================================
# The product-type mutation roots — the catalog owner's goods-schema
# ADMIN write use case over the EXISTING product_types table (no new
# migration). Signatures are the pinned 3.23.43 shapes (note the pinned
# root's own REQUIRED id arguments — unlike the category roots, Saleor's
# productTypeDelete/productTypeUpdate carry no externalReference
# argument at all).
# =====================================================================
extend type Mutation {
    """Creates a new product type."""
    productTypeCreate(
        """Fields required to create a product type."""
        input: ProductTypeInput!
    ): ProductTypeCreate

    """Deletes a product type."""
    productTypeDelete(
        """ID of a product type to delete."""
        id: ID!
    ): ProductTypeDelete

    """Deletes product types."""
    productTypeBulkDelete(
        """List of product type IDs to delete."""
        ids: [ID!]!
    ): ProductTypeBulkDelete

    """Updates an existing product type."""
    productTypeUpdate(
        """ID of a product type to update."""
        id: ID!

        """Fields required to update a product type."""
        input: ProductTypeInput!
    ): ProductTypeUpdate
}

# =====================================================================
# The bounded ProductTypeInput — the pinned Saleor input's OWNED field
# set only: name and slug (the row's name_en / code columns). The
# unowned members (kind — no kind column, hasVariants — deprecated and
# unowned, productAttributes/variantAttributes — the assignment
# capability is its own root family, isShippingRequired/isDigital — no
# columns, weight — no scalar owner, taxCode — no tax owner) stay
# undeclared — recorded divergences, never faked.
# =====================================================================
input ProductTypeInput {
    """Name of the product type (the bilingual row's primary name — name_en)."""
    name: String

    """Product type slug (the row's stable public code)."""
    slug: String
}

type ProductTypeCreate {
    errors: [ProductError!]!
    productType: ProductType
}

type ProductTypeUpdate {
    errors: [ProductError!]!
    productType: ProductType
}

type ProductTypeDelete {
    errors: [ProductError!]!
    productType: ProductType
}

type ProductTypeBulkDelete {
    """Returns how many objects were affected."""
    count: Int!
    errors: [ProductError!]!
}

# =====================================================================
# The product mutation roots — the catalog owner's PROVIDER-scoped
# product write use case over the EXISTING products table (no new
# migration). Signatures are the pinned 3.23.43 shapes; the
# declared-but-unowned arguments (externalReference — no external-ID
# column) answer the classified validation error when sent. The
# platform's ownership law for provider-owned rows rides the owning
# use case: the row's provider is the CALLER (the two-sided
# marketplace's own boundary — the recorded RBAC divergence), so an
# id the caller does not own answers the safe NOT_FOUND absence.
# =====================================================================
extend type Mutation {
    """Creates a new product."""
    productCreate(
        """Fields required to create a product."""
        input: ProductCreateInput!
    ): ProductCreate

    """Deletes a product."""
    productDelete(
        """
        External ID of a product to delete. No external-ID column
        exists on this platform (the registered divergence); a non-null
        value answers the classified validation error.
        """
        externalReference: String

        """ID of a product to delete."""
        id: ID
    ): ProductDelete

    """Deletes products."""
    productBulkDelete(
        """List of product IDs to delete."""
        ids: [ID!]!
    ): ProductBulkDelete

    """Updates an existing product."""
    productUpdate(
        """
        External ID of a product to update. No external-ID column
        exists on this platform; a non-null value answers the classified
        validation error.
        """
        externalReference: String

        """ID of a product to update."""
        id: ID

        """Fields required to update a product."""
        input: ProductInput!
    ): ProductUpdate
}

# =====================================================================
# The bounded ProductCreateInput — the pinned Saleor input's OWNED field
# set (name, description, productType — the row's title/description/
# product_type_id columns) PLUS the platform-extension facts the row's
# own NOT NULL policy requires (storeCategoryCode, priceMinor,
# currency — the voucher slice's own "platform-only fields as
# extensions" precedent). The Saleor `category: ID` argument family
# stays undeclared: the products row's category reference is the
# platform's store-categories dictionary BY CODE (a different taxonomy
# than the Saleor categories registry — a recorded divergence). The
# unowned members (the attributes family, the JSON rich-text
# description, SEO/metadata, collections, chargeTaxes, slug,
# externalReference, publication state, tax class, weight, rating,
# media) stay undeclared — recorded divergences, never faked.
# =====================================================================
input ProductCreateInput {
    """Product name (the entity's own display title)."""
    name: String

    """Product description (plain text on this surface)."""
    description: String

    """
    ID of the product's reusable goods schema (typed global ID of the
    ProductType root's type; null keeps pre-C1 and zero-variant
    products compatible — a typed product starts as DRAFT).
    """
    productType: ID

    """
    PLATFORM EXTENSION (the row's NOT NULL category reference): the
    stable code of the store-categories dictionary row the product
    belongs to.
    """
    storeCategoryCode: String

    """
    PLATFORM EXTENSION (the row's NOT NULL price policy): the
    authoritative unit price in minor units (a non-negative amount).
    """
    priceMinor: Int

    """PLATFORM EXTENSION: the price's ISO-4217 currency code."""
    currency: String
}

# =====================================================================
# The bounded ProductInput — the pinned Saleor input's OWNED movable
# set only: name, description and the price (the platform's own
# product-update law; the row's ownership facts and lifecycle state
# are each their own owning capability, never an update side effect).
# Omitted (null) fields preserve the column.
# =====================================================================
input ProductInput {
    """Product name (the entity's own display title)."""
    name: String

    """Product description (plain text on this surface)."""
    description: String

    """
    PLATFORM EXTENSION: the authoritative unit price in minor units
    (a non-negative amount; omitted preserves the column).
    """
    priceMinor: Int
}

type ProductCreate {
    errors: [ProductError!]!
    product: Product
}

type ProductUpdate {
    errors: [ProductError!]!
    product: Product
}

type ProductDelete {
    errors: [ProductError!]!
    product: Product
}

type ProductBulkDelete {
    """Returns how many objects were affected."""
    count: Int!
    errors: [ProductError!]!
}

# =====================================================================
# The product-variant mutation roots — the catalog owner's variant
# write use case over the EXISTING product_variants table (V219, the
# ADR-0012 registry). Signatures are the pinned 3.23.43 shapes for the
# owned argument set; the declared-but-unowned arguments
# (externalReference — no external-ID column; sku/skus — the id is the
# addressing key on this platform, the SKU is seller-namespaced)
# answer the classified validation error when sent.
# =====================================================================
extend type Mutation {
    """Creates a new product variant."""
    productVariantCreate(
        """
        Fields required to create a product variant. The bounded owned
        set: the owning product, the seller's SKU, the display name and
        the platform-extension price carrier (the row's NOT NULL
        price_minor policy). The typed-attribute selection family
        (attributes — the platform's own assignment-addressed
        vocabulary on its store-product surface) and the
        warehouse-scoped stocks family (D-WHSE-001) stay undeclared —
        recorded divergences, never faked.
        """
        input: ProductVariantCreateInput!
    ): ProductVariantCreate

    """Updates a product variant."""
    productVariantUpdate(
        """
        External ID of a product variant to update. No external-ID
        column exists on this platform; a non-null value answers the
        classified validation error.
        """
        externalReference: String

        """ID of a product variant to update."""
        id: ID

        """
        Fields required to update a product variant (the bounded
        movable set: sku, name and the platform-extension price
        carrier; omitted fields preserve the column).
        """
        input: ProductVariantInput!

        """
        SKU of a product variant to update. The id is the addressing
        key on this platform (the SKU is seller-namespaced, not a
        global key); a non-null value answers the classified validation
        error.
        """
        sku: String
    ): ProductVariantUpdate

    """Deletes a product variant."""
    productVariantDelete(
        """
        External ID of a product variant to delete. No external-ID
        column exists on this platform; a non-null value answers the
        classified validation error.
        """
        externalReference: String

        """ID of a product variant to delete."""
        id: ID

        """
        SKU of a product variant to delete. The id is the addressing
        key on this platform; a non-null value answers the classified
        validation error.
        """
        sku: String
    ): ProductVariantDelete

    """Deletes product variants."""
    productVariantBulkDelete(
        """List of product variant IDs to delete."""
        ids: [ID!]

        """
        List of product variant SKUs to delete. The ids are the
        addressing keys on this platform; a non-null value answers the
        classified validation error.
        """
        skus: [String!]
    ): ProductVariantBulkDelete
}

# =====================================================================
# The bounded ProductVariantCreateInput — the pinned Saleor input's
# OWNED field set only: the owning product reference and the row's own
# direct facts (sku, name) plus the platform-extension price carrier
# (the row's NOT NULL price policy — the voucher slice's own
# "platform-only fields as extensions" policy). The unowned members
# (attributes — the platform's own assignment-addressed vocabulary on
# its store-product surface; stocks — warehouse-scoped, D-WHSE-001;
# trackInventory/weight/preorder/quantityLimitPerCustomer/metadata/
# privateMetadata/externalReference) have no owning capabilities on
# this surface and stay undeclared — recorded divergences, never
# faked.
# =====================================================================
input ProductVariantCreateInput {
    """ID of the product the variant registers under (typed global ID of the Product root's type)."""
    product: ID!

    """The seller's own SKU (unique within the seller's namespace)."""
    sku: String

    """The option's display name (e.g. «Large / Red»)."""
    name: String

    """
    PLATFORM EXTENSION (the row's NOT NULL price policy): the
    variant's authoritative unit price in minor units (a non-negative
    amount).
    """
    priceMinor: Int
}

# =====================================================================
# The bounded ProductVariantInput — the pinned Saleor input's OWNED
# movable set only: the SKU, the display name and the
# platform-extension price carrier (the row's own amendable facts —
# the entity's reviseDetails seam). The ownership facts (product,
# provider, currency — the denormalized copies), the reserved counter
# and the availability lifecycle are each their own owning
# capability, never an update side effect. Omitted (null) fields
# preserve the column.
# =====================================================================
input ProductVariantInput {
    """The seller's own SKU (null preserves; a new value must stay free in the seller's namespace)."""
    sku: String

    """The option's display name (null preserves)."""
    name: String

    """
    PLATFORM EXTENSION: the authoritative unit price in minor units (a
    non-negative amount; null preserves the column).
    """
    priceMinor: Int
}

type ProductVariantCreate {
    errors: [ProductError!]!
    productVariant: ProductVariant
}

type ProductVariantUpdate {
    errors: [ProductError!]!
    productVariant: ProductVariant
}

type ProductVariantDelete {
    errors: [ProductError!]!
    productVariant: ProductVariant
}

type ProductVariantBulkDelete {
    """Returns how many objects were affected."""
    count: Int!
    errors: [ProductError!]!
}

# =====================================================================
# The voucher mutation roots — the pricing owner's voucher-policy ADMIN
# write use case over the EXISTING vouchers table (V223). Signatures are
