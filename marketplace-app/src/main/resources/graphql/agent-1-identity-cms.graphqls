    pageErrors: [PageError!]! @deprecated(reason: "Use `errors` field instead.")
    errors: [PageError!]!
}

type PageTypeDelete {
    pageType: PageType
    pageErrors: [PageError!]! @deprecated(reason: "Use `errors` field instead.")
    errors: [PageError!]!
}

type PageTypeBulkDelete {
    count: Int!
    pageErrors: [PageError!]! @deprecated(reason: "Use `errors` field instead.")
    errors: [PageError!]!
}

type PageAttributeAssign {
    pageType: PageType
    pageErrors: [PageError!]! @deprecated(reason: "Use `errors` field instead.")
    errors: [PageError!]!
}

type PageAttributeUnassign {
    pageType: PageType
    pageErrors: [PageError!]! @deprecated(reason: "Use `errors` field instead.")
    errors: [PageError!]!
}

type PageTypeReorderAttributes {
    pageType: PageType
    pageErrors: [PageError!]! @deprecated(reason: "Use `errors` field instead.")
    errors: [PageError!]!
}

type AssignNavigation {
    shopErrors: [ShopError!]! @deprecated(reason: "Use `errors` field instead.")
    errors: [ShopError!]!
}

type MenuCreate {
    menu: Menu
    menuErrors: [MenuError!]! @deprecated(reason: "Use `errors` field instead.")
    errors: [MenuError!]!
}

type MenuUpdate {
    menu: Menu
    menuErrors: [MenuError!]! @deprecated(reason: "Use `errors` field instead.")
    errors: [MenuError!]!
}

type MenuDelete {
    menu: Menu
    menuErrors: [MenuError!]! @deprecated(reason: "Use `errors` field instead.")
    errors: [MenuError!]!
}

type MenuBulkDelete {
    count: Int!
    menuErrors: [MenuError!]! @deprecated(reason: "Use `errors` field instead.")
    errors: [MenuError!]!
}

type MenuItemCreate {
    menuItem: MenuItem
    menuErrors: [MenuError!]! @deprecated(reason: "Use `errors` field instead.")
    errors: [MenuError!]!
