# =============================================================================
# Error types + code enums (the Saleor wire taxonomy; the platform's native
# validation/authorization failures map into these codes — the code enums
# carry the full pinned vocabulary with unemitted members inert, the
# PermissionEnum precedent)
# =============================================================================

type AccountError {
    field: String
    message: String
    code: AccountErrorCode!
}

type StaffError {
    field: String
    message: String
    code: AccountErrorCode!
    addressType: AddressTypeEnum
    permissions: [PermissionEnum!]
    groups: [ID!]
    users: [ID!]
}

type ShopError {
    field: String
    message: String
    code: ShopErrorCode!
}

type CustomerBulkUpdateError {
    field: String
    message: String
    code: CustomerBulkUpdateErrorCode!
}

type CustomerTypeCreateError {
    field: String
    message: String
    code: CustomerTypeCreateErrorCode!
}

type CustomerTypeUpdateError {
    field: String
    message: String
    code: CustomerTypeUpdateErrorCode!
}

type CustomerTypeDeleteError {
    field: String
    message: String
    code: CustomerTypeDeleteErrorCode!
}

type CustomerTypeAssignAttributesError {
    field: String
    message: String
    code: CustomerTypeAssignAttributesErrorCode!
}

type CustomerTypeUnassignAttributesError {
    field: String
    message: String
    code: CustomerTypeUnassignAttributesErrorCode!
}

type CustomerTypeReorderAttributesError {
    field: String
    message: String
    code: CustomerTypeReorderAttributesErrorCode!
}

type PageError {
    field: String
    message: String
    code: PageErrorCode!
    attributes: [ID!]
    values: [ID!]
}

type MenuError {
    field: String
    message: String
    code: MenuErrorCode!
    menuItems: [ID!]
}

enum AccountErrorCode {
    ACTIVATE_OWN_ACCOUNT
    ALREADY_EXISTS
    CONFIRMATION_ALREADY_REQUESTED
    DEACTIVATE_OWN_ACCOUNT
    DELETE_OWN_ACCOUNT
    DELETE_STAFF_ACCOUNT
    DELETE_SUPERUSER_ACCOUNT
    GRAPHQL_ERROR
    INACTIVE
    INVALID
    INVALID_CREDENTIALS
    INVALID_PASSWORD
    JWT_DECODE_ERROR
    JWT_INVALID_CSRF_TOKEN
    JWT_INVALID_TOKEN
    JWT_MISSING_TOKEN
    JWT_SIGNATURE_EXPIRED
    LEFT_NOT_MANAGEABLE_PERMISSION
    NOT_FOUND
    OUT_OF_SCOPE_GROUP
    OUT_OF_SCOPE_PERMISSION
    OUT_OF_SCOPE_USER
    PASSWORD_ENTIRELY_NUMERIC
    PASSWORD_RESET_ALREADY_REQUESTED
    PASSWORD_TOO_COMMON
    PASSWORD_TOO_SHORT
    PASSWORD_TOO_SIMILAR
    REQUIRED
    UNIQUE
}

enum ShopErrorCode {
    ALREADY_EXISTS
    GRAPHQL_ERROR
    INVALID
    NOT_FOUND
    REQUIRED
    UNIQUE
}

enum CustomerBulkUpdateErrorCode {
    GRAPHQL_ERROR
    INVALID
    NOT_FOUND
    REQUIRED
}

enum CustomerTypeCreateErrorCode {
    ALREADY_EXISTS
    GRAPHQL_ERROR
    INVALID
    REQUIRED
    UNIQUE
}

enum CustomerTypeUpdateErrorCode {
    ALREADY_EXISTS
    GRAPHQL_ERROR
    INVALID
    NOT_FOUND
    REQUIRED
    UNIQUE
}

enum CustomerTypeDeleteErrorCode {
    CANNOT_DELETE_DEFAULT
    GRAPHQL_ERROR
    INVALID
    NOT_FOUND
    UNIQUE
}

enum CustomerTypeAssignAttributesErrorCode {
    ALREADY_EXISTS
    ATTRIBUTE_ALREADY_ASSIGNED
    GRAPHQL_ERROR
    INVALID
    NOT_FOUND
    REQUIRED
    UNIQUE
}

enum CustomerTypeUnassignAttributesErrorCode {
    GRAPHQL_ERROR
    INVALID
    NOT_FOUND
    REQUIRED
    UNIQUE
}

enum CustomerTypeReorderAttributesErrorCode {
    GRAPHQL_ERROR
    INVALID
    NOT_FOUND
    REQUIRED
    UNIQUE
}

enum PageErrorCode {
    ALREADY_EXISTS
    GRAPHQL_ERROR
    INVALID
    NOT_FOUND
    REQUIRED
    UNIQUE
}

enum MenuErrorCode {
    CANNOT_ASSIGN_NODE
    DUPLICATED_INPUT_ITEM
    GRAPHQL_ERROR
    INVALID
    INVALID_MENU_ITEM
    NO_MENU_ITEM_PROVIDED
    NOT_FOUND
    REQUIRED
    TOO_MANY_MENU_ITEMS
    UNIQUE
}
