# =============================================================================
# Agent 1 — Identity / Authentication / CMS Pages & Navigation SDL fragment
# (the Saleor 458-root campaign, assignment packet PR #696)
#
# House contract (frozen-contracts.md + the assignment's isolation rules):
#  - This file is Agent 1's ONLY SDL surface; the central schema.graphqls is
#    never touched. DGS codegen reads this directory via schemaPaths, so this
#    fragment composes with the central schema at build time.
#  - Roots use `extend type Query`/`extend type Mutation`; shared types are
#    never re-declared (only `extend type User` adds the address read-back).
#  - No new scalars (the recorded house decision): Saleor Date/DateTime/
#    JSONString/GenericScalar render as ISO-8601/serialized-JSON String.
#  - Metadata/privateMetadata fields are absent-by-design on every type here
#    (no metadata subsystem exists; recorded in the divergence proposals —
#    absent beats inert, the User.firstName precedent).
#  - Saleor 3.23.43 pinned schema (blob b8fa0dd809081f76dc2834bb5c286561e5783276)
#    is the signature authority; every declared root below carries its exact
#    argument names/nullability minus the absent-by-design fields.
#  - BLOCKED roots stay UNDECLARED on the wire (the frozen blocked-roots
#    protocol — no fake records, no silent no-op resolvers): external*
#    authentication plugin bridge (D-EXTAUTH-001), userAvatarUpdate/Delete
#    (D-AVATAR-001), permissionGroupCreate/Update/Delete (D-PGRP-001 — the
#    closed platform role vocabulary IS the group collection),
#    addressValidationRules (D-ADDR-001-b — no per-country validation-rules
#    engine), pageReorderAttributeValues (D-PAGE-ATTR-001 — no page attribute
#    value store this slice).
# =============================================================================

extend type Mutation {
    # --- P1: Authentication ------------------------------------------------
    tokenCreate(audience: String, email: String!, password: String!): CreateToken
    tokenRefresh(csrfToken: String, refreshToken: String): RefreshToken
    tokenVerify(token: String!): VerifyToken
    tokensDeactivateAll: DeactivateAllUserTokens

    # --- P1: account/password lifecycle ------------------------------------
    requestPasswordReset(channel: String, email: String!, redirectUrl: String!): RequestPasswordReset
    sendConfirmationEmail(channel: String!, redirectUrl: String!): SendConfirmationEmail
    confirmAccount(email: String!, password: String, token: String!): ConfirmAccount
    setPassword(email: String!, password: String!, token: String!): SetPassword
    passwordChange(newPassword: String!, oldPassword: String): PasswordChange
    requestEmailChange(channel: String, newEmail: String!, password: String!, redirectUrl: String!): RequestEmailChange
    confirmEmailChange(channel: String, token: String!): ConfirmEmailChange

    # --- P1: the caller's own account --------------------------------------
    accountRegister(input: AccountRegisterInput!): AccountRegister
    accountUpdate(customerId: ID, input: AccountInput!): AccountUpdate
    accountRequestDeletion(channel: String, redirectUrl: String!): AccountRequestDeletion
    accountDelete(token: String!): AccountDelete
    accountAddressCreate(customerId: ID, input: AddressInput!, type: AddressTypeEnum): AccountAddressCreate
    accountAddressUpdate(id: ID!, input: AddressInput!): AccountAddressUpdate
    accountAddressDelete(id: ID!): AccountAddressDelete
    accountSetDefaultAddress(id: ID!, type: AddressTypeEnum!): AccountSetDefaultAddress

    # --- P1: staff-managed user addresses ----------------------------------
    addressCreate(input: AddressInput!, userId: ID!): AddressCreate
    addressUpdate(id: ID!, input: AddressInput!): AddressUpdate
    addressDelete(id: ID!): AddressDelete
    addressSetDefault(addressId: ID!, type: AddressTypeEnum!, userId: ID!): AddressSetDefault

    # --- P1: customer management (MANAGE_USERS) ----------------------------
    customerCreate(input: UserCreateInput!): CustomerCreate
    customerUpdate(externalReference: String, id: ID, input: CustomerInput!): CustomerUpdate
    customerDelete(externalReference: String, id: ID): CustomerDelete
    customerBulkDelete(ids: [ID!]!): CustomerBulkDelete
    customerBulkUpdate(customers: [CustomerBulkUpdateInput!]!, errorPolicy: ErrorPolicyEnum): CustomerBulkUpdate

    # --- P1: customer types --------------------------------------------------
    customerTypeCreate(input: CustomerTypeCreateInput!): CustomerTypeCreate
    customerTypeUpdate(id: ID!, input: CustomerTypeUpdateInput!): CustomerTypeUpdate
    customerTypeDelete(id: ID!): CustomerTypeDelete
    customerTypeAssignAttributes(attributeIds: [ID!]!, customerTypeId: ID!): CustomerTypeAssignAttributes
    customerTypeUnassignAttributes(attributeIds: [ID!]!, customerTypeId: ID!): CustomerTypeUnassignAttributes
    customerTypeReorderAttributes(customerTypeId: ID!, moves: [ReorderInput!]!): CustomerTypeReorderAttributes

    # --- P1: staff management (MANAGE_STAFF) --------------------------------
    staffCreate(input: StaffCreateInput!): StaffCreate
    staffUpdate(id: ID!, input: StaffUpdateInput!): StaffUpdate
    staffDelete(id: ID!): StaffDelete
    staffBulkDelete(ids: [ID!]!): StaffBulkDelete
    userBulkSetActive(ids: [ID!]!, isActive: Boolean!): UserBulkSetActive

    # --- P1: staff notification recipients (MANAGE_STAFF) -------------------
    staffNotificationRecipientCreate(input: StaffNotificationRecipientInput!): StaffNotificationRecipientCreate
    staffNotificationRecipientUpdate(id: ID!, input: StaffNotificationRecipientInput!): StaffNotificationRecipientUpdate
    staffNotificationRecipientDelete(id: ID!): StaffNotificationRecipientDelete

    # --- P5: CMS pages --------------------------------------------------------
    pageCreate(input: PageCreateInput!): PageCreate
    pageUpdate(id: ID!, input: PageInput!): PageUpdate
    pageDelete(id: ID!): PageDelete
    pageBulkDelete(ids: [ID!]!): PageBulkDelete
    pageBulkPublish(ids: [ID!]!, isPublished: Boolean!): PageBulkPublish
    pageTranslate(id: ID!, input: PageTranslationInput!, languageCode: LanguageCodeEnum!): PageTranslate

    # --- P5: CMS page types ---------------------------------------------------
    pageTypeCreate(input: PageTypeCreateInput!): PageTypeCreate
    pageTypeUpdate(id: ID, input: PageTypeUpdateInput!): PageTypeUpdate
    pageTypeDelete(id: ID!): PageTypeDelete
    pageTypeBulkDelete(ids: [ID!]!): PageTypeBulkDelete
    pageAttributeAssign(attributeIds: [ID!]!, pageTypeId: ID!): PageAttributeAssign
    pageAttributeUnassign(attributeIds: [ID!]!, pageTypeId: ID!): PageAttributeUnassign
    pageTypeReorderAttributes(moves: [ReorderInput!]!, pageTypeId: ID!): PageTypeReorderAttributes

    # --- P5: navigation --------------------------------------------------------
    assignNavigation(menu: ID, navigationType: NavigationType!): AssignNavigation
    menuCreate(input: MenuCreateInput!): MenuCreate
    menuUpdate(id: ID!, input: MenuInput!): MenuUpdate
    menuDelete(id: ID!): MenuDelete
    menuBulkDelete(ids: [ID!]!): MenuBulkDelete
    menuItemCreate(input: MenuItemCreateInput!): MenuItemCreate
    menuItemUpdate(id: ID!, input: MenuItemInput!): MenuItemUpdate
    menuItemDelete(id: ID!): MenuItemDelete
    menuItemBulkDelete(ids: [ID!]!): MenuItemBulkDelete
    menuItemTranslate(id: ID!, input: NameTranslationInput!, languageCode: LanguageCodeEnum!): MenuItemTranslate
    menuItemMove(menu: ID!, moves: [MenuItemMoveInput!]!): MenuItemMove
}

extend type Query {
    # --- P1 reads over the owners this packet builds --------------------------
    address(id: ID!): Address
    customerType(id: ID!): CustomerType
    customerTypes(
        after: String,
        before: String,
        first: Int,
        last: Int,
        search: String,
        sortBy: CustomerTypeSortingInput,
        where: CustomerTypeWhereInput
    ): CustomerTypeCountableConnection

    # --- P5 CMS reads ------------------------------------------------------------
    page(channel: String, id: ID, slug: String, slugLanguageCode: LanguageCodeEnum): Page
    pages(
        after: String,
        before: String,
        channel: String,
        filter: PageFilterInput,
        first: Int,
        last: Int,
        search: String,
        sortBy: PageSortingInput,
        where: PageWhereInput
    ): PageCountableConnection
    pageType(id: ID!): PageType
    pageTypes(
        after: String,
        before: String,
        filter: PageTypeFilterInput,
        first: Int,
        last: Int,
        sortBy: PageTypeSortingInput
    ): PageTypeCountableConnection
    menu(channel: String, id: ID, name: String, slug: String): Menu
    menus(
        after: String,
        before: String,
        channel: String,
        filter: MenuFilterInput,
        first: Int,
        last: Int,
        sortBy: MenuSortingInput
    ): MenuCountableConnection
    menuItem(channel: String, id: ID!): MenuItem
    menuItems(
        after: String,
        before: String,
        channel: String,
        filter: MenuItemFilterInput,
        first: Int,
        last: Int,
        sortBy: MenuItemSortingInput
    ): MenuItemCountableConnection
}

# The customer-editor read-back for the address lifecycle above: the caller's
# or a managed customer's address book rides the SHARED User type (additive
# extend — the typed-Global-ID codec's own User tag, resolved through the
# identity owner's address use case, never a second user projection).
extend type User {
    addresses: [Address!]
    defaultBillingAddress: Address
    defaultShippingAddress: Address
}

# =============================================================================
# Entities
# =============================================================================

# Saleor's Address shape (Users domain) — the identity owner's user-account
# address book. Metadata absent-by-design; temporal fields as ISO-8601
# strings. The id is the typed global ID (codec tag "Address").
type Address {
    id: ID!
    firstName: String!
    lastName: String!
    companyName: String!
    streetAddress1: String!
    streetAddress2: String!
    city: String!
    cityArea: String!
    postalCode: String!
    country: CountryDisplay!
    countryArea: String!
    phone: String
    isDefaultShippingAddress: Boolean
    isDefaultBillingAddress: Boolean
}

type CountryDisplay {
    code: CountryCode!
    country: String!
}

# Saleor's staff-notification-recipient registry row (order-event mail
# routing). Oneof-style owner: either a staff user reference or a bare email.
type StaffNotificationRecipient {
    id: ID!
    user: User
    email: String
    active: Boolean!
}

# Saleor's customer type (B2B segmentation with assigned attributes). The
# assigned attributes reference the catalog module's attribute registry
# (validated at the composition boundary through its declared read SPI).
type CustomerType {
    id: ID!
    name: String!
    slug: String!
    isDefault: Boolean!
    attributes: [Attribute!]
}

# Saleor's CMS page. `content` is the serialized rich-text JSON document
# (EditorJS-shaped) stored as-is by the owning use case — the no-new-scalar
# divergence renders it as String on the wire. `publishedAt` is ISO-8601.
type Page {
    id: ID!
    seoTitle: String
    seoDescription: String
    title: String!
    content: String
    isPublished: Boolean!
    publishedAt: String
    slug: String!
    created: String
    pageType: PageType!
    translation(languageCode: LanguageCodeEnum!): PageTranslation
}

type PageTranslation {
    id: ID!
    seoTitle: String
    seoDescription: String
    title: String!
    content: String
    language: LanguageCodeEnum!
}

# Saleor's page type (the page's attributed classification). The assigned
# attribute set is owned and positioned by the console CMS owner.
type PageType {
    id: ID!
    name: String!
    slug: String!
    attributes: [Attribute!]
}

# Saleor's navigation menu tree. Items form a forest rooted at the menu with
# the platform's cycle-guarded move semantics.
type Menu {
    id: ID!
    name: String!
    slug: String!
    items: [MenuItem!]!
}

type MenuItem {
    id: ID!
    menu: Menu!
    parent: MenuItem
    category: Category
    page: Page
    level: Int!
    children: [MenuItem!]
    name: String!
    url: String
    translation(languageCode: LanguageCodeEnum!): MenuItemTranslation
}

type MenuItemTranslation {
    id: ID!
    name: String!
    language: LanguageCodeEnum!
}

# =============================================================================
# Connections (the declared Saleor countable envelopes — the house keyset
# contract: forward-only first/after, per-element cursors, real totalCount)
# =============================================================================

type CustomerTypeCountableConnection {
    pageInfo: PageInfo!
    edges: [CustomerTypeCountableEdge!]!
    totalCount: Int
}

type CustomerTypeCountableEdge {
    node: CustomerType!
    cursor: String!
}

type PageCountableConnection {
    pageInfo: PageInfo!
    edges: [PageCountableEdge!]!
    totalCount: Int
}

type PageCountableEdge {
    node: Page!
    cursor: String!
}

type PageTypeCountableConnection {
    pageInfo: PageInfo!
    edges: [PageTypeCountableEdge!]!
    totalCount: Int
}

type PageTypeCountableEdge {
    node: PageType!
    cursor: String!
}

type MenuCountableConnection {
    pageInfo: PageInfo!
    edges: [MenuCountableEdge!]!
    totalCount: Int
}

type MenuCountableEdge {
    node: Menu!
    cursor: String!
}

type MenuItemCountableConnection {
    pageInfo: PageInfo!
    edges: [MenuItemCountableEdge!]!
    totalCount: Int
}

type MenuItemCountableEdge {
    node: MenuItem!
    cursor: String!
}

# =============================================================================
# Inputs (exact Saleor shapes minus absent-by-design fields: metadata/
# privateMetadata, per-user languageCode, free-text note, attribute-value
# assignments with no owning store this slice)
# =============================================================================

input AddressInput {
    firstName: String
    lastName: String
    companyName: String
    streetAddress1: String
    streetAddress2: String
    city: String
    cityArea: String
    postalCode: String
    country: CountryCode
    countryArea: String
    phone: String
}

input AccountRegisterInput {
    firstName: String
    lastName: String
    email: String!
    password: String!
    redirectUrl: String
    channel: String
}

input AccountInput {
    firstName: String
    lastName: String
    defaultBillingAddress: AddressInput
    defaultShippingAddress: AddressInput
}

input UserCreateInput {
    defaultBillingAddress: AddressInput
    defaultShippingAddress: AddressInput
    firstName: String
    lastName: String
    email: String
    isActive: Boolean
    customerType: ID
    redirectUrl: String
    channel: String
}

input CustomerInput {
    defaultBillingAddress: AddressInput
    defaultShippingAddress: AddressInput
    firstName: String
    lastName: String
    email: String
    isActive: Boolean
    customerType: ID
}

input CustomerBulkUpdateInput {
    id: ID
    externalReference: String
    input: CustomerInput!
}

input StaffCreateInput {
    firstName: String
    lastName: String
    email: String
    isActive: Boolean
    addGroups: [ID!]
    redirectUrl: String
}

input StaffUpdateInput {
    firstName: String
    lastName: String
    email: String
    isActive: Boolean
    addGroups: [ID!]
    removeGroups: [ID!]
}

input StaffNotificationRecipientInput {
    user: ID
    email: String
    active: Boolean
}

input CustomerTypeCreateInput {
    name: String
    slug: String
    isDefault: Boolean
}

input CustomerTypeUpdateInput {
    name: String
    slug: String
    isDefault: Boolean
}

input PageCreateInput {
    slug: String
    title: String
    content: String
    isPublished: Boolean
    publishedAt: String
    seo: SeoInput
    pageType: ID!
}

input PageInput {
    slug: String
    title: String
    content: String
    isPublished: Boolean
    publishedAt: String
    seo: SeoInput
}

input SeoInput {
    title: String
    description: String
}

input PageTranslationInput {
    slug: String
    seoTitle: String
    seoDescription: String
    title: String
    content: String
}

input PageTypeCreateInput {
    name: String
    slug: String
    addAttributes: [ID!]
}

input PageTypeUpdateInput {
    name: String
    slug: String
    addAttributes: [ID!]
    removeAttributes: [ID!]
}

input MenuCreateInput {
    name: String!
    slug: String
    items: [MenuItemInput!]
}

input MenuInput {
    name: String
    slug: String
}

input MenuItemCreateInput {
    name: String!
    menu: ID!
    parent: ID
    url: String
    category: ID
    collection: ID
    page: ID
}

input MenuItemInput {
    name: String
    url: String
    category: ID
    collection: ID
    page: ID
}

input MenuItemMoveInput {
    itemId: ID!
    parentId: ID
    sortOrder: Int
}

# Bounded where/filter inputs (the CategoryWhereInput precedent: the executed
# subset is declared; helper types with no owning capability stay absent).

input CustomerTypeWhereInput {
    ids: [ID!]
    name: StringFilterInput
    slug: StringFilterInput
    isDefault: Boolean
}

input StringFilterInput {
    eq: String
    oneOf: [String!]
}

input PageFilterInput {
    search: String
    slug: [String!]
    pageTypes: [ID!]
    isPublished: Boolean
}

input PageWhereInput {
    ids: [ID!]
    slug: StringFilterInput
    pageType: ID
    isPublished: Boolean
}

input PageTypeFilterInput {
    search: String
    slugs: [String!]
}

input MenuFilterInput {
    search: String
    slug: [String!]
}

input MenuItemFilterInput {
    search: String
    slug: [String!]
}

input CustomerTypeSortingInput {
    direction: OrderDirection!
    field: CustomerTypeSortField!
}

input PageSortingInput {
    direction: OrderDirection!
    field: PageSortField!
}

input PageTypeSortingInput {
    direction: OrderDirection!
    field: PageTypeSortField!
}

input MenuSortingInput {
    direction: OrderDirection!
    field: MenuSortField!
}

input MenuItemSortingInput {
    direction: OrderDirection!
    field: MenuItemsSortField!
}

enum CustomerTypeSortField {
    NAME
    SLUG
}

enum PageSortField {
    SLUG
    TITLE
    CREATED_AT
    PUBLICATION_DATE
}

enum PageTypeSortField {
    NAME
    SLUG
}

enum MenuSortField {
    NAME
    SLUG
    ITEMS_COUNT
}

enum MenuItemsSortField {
    NAME
    SLUG
}

enum AddressTypeEnum {
    BILLING
    SHIPPING
}

enum NavigationType {
    MAIN
    SECONDARY
}

