    <build>
        <plugins>
            <!-- GraphQL DGS CodeGen (target architecture §11 Phase 3):
                 schema-first code generated from the authoritative SDL
                 at build time, Maven-owned. The community adapter
                 (io.github.deweyjose — Netflix's official CodeGen plugin
                 is Gradle-only) is pinned in the ROOT pom per the plan's
                 provenance rule. Its `generate` goal binds to the
                 generate-sources phase (the plugin's documented default),
                 and the output lands isolated under
                 target/generated-sources/graphql-codegen — separate from
                 MapStruct's target/generated-sources/annotations —
                 added to the compile source roots automatically, never
                 committed or hand-edited.
                 Transport types ON (Phase 3.3/3.4 — the
                 equivalence-proven half of the plan): the generated
                 types.Service data type and types.ServiceStatus enum,
                 straight from the SDL with the engine's documented
                 scalar mapping (ID -> String, Float -> double —
                 measured from the graphql-dgs-codegen 8.6.0 sources),
                 are the adapter boundary's wire contract — the official
                 docs' own intended use for generated data types ("return
                 types for your datafetchers"). The hand-written
                 ServiceResponse record is replaced, not paralleled: no
                 second transport DTO. The root Query/Mutation types
                 generate no data types (the engine excludes them by
                 name), and client API generation stays off (no
                 server-to-server use case), no docs, no example
                 fetchers.
                 Input types stay hand-owned: ServiceInput's Jakarta
                 Validation contract is not expressible in SDL without
                 changing the schema contract (the Phase 3.4 equivalence
                 rule), so the adapter is told to USE the existing record
                 through typeMapping instead of generating a duplicate —
                 the engine's documented mechanism for existing classes
                 (mapped types are skipped from generation; measured in
                 the 8.6.0 source's shouldSkip). -->
            <plugin>
                <groupId>io.github.deweyjose</groupId>
                <artifactId>graphqlcodegen-maven-plugin</artifactId>
                <version>${graphql-codegen-plugin.version}</version>
                <executions>
                    <execution>
                        <id>generate-graphql-schema-code</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <schemaPaths>
                        <path>${project.basedir}/src/main/resources/graphql</path>
                    </schemaPaths>
                    <!-- Keep CodeGen output separate from MapStruct's
                         target/generated-sources/annotations directory. -->
                    <outputDir>${project.build.directory}/generated-sources/graphql-codegen</outputDir>
                    <packageName>com.marketplace.app.graphql.generated</packageName>
                    <!-- The hand-owned input record IS the surface's single
                         input DTO: the engine skips generating a duplicate
                         for mapped types and uses this class wherever the
                         schema references ServiceInput. -->
                    <typeMapping>
                        <ServiceInput>com.marketplace.app.graphql.ServiceInput</ServiceInput>
                        <StoreProductCreateInput>com.marketplace.app.graphql.StoreProductCreateInput</StoreProductCreateInput>
                        <StoreProductUpdateInput>com.marketplace.app.graphql.StoreProductUpdateInput</StoreProductUpdateInput>
                    </typeMapping>
                    <generateDataTypes>true</generateDataTypes>
                    <!-- The adapter's Mojo default for the all-fields
                         constructor deviates from the engine's documented
                         shape (core default true; official docs: "POJOs
                         with both a non-arg constructor, a constructor
                         for all fields, and implementations for hashCode/
                         equals/toString ... a builder class") — pin the
                         documented shape explicitly. -->
                    <javaGenerateAllConstructor>true</javaGenerateAllConstructor>
                    <generateClientApi>false</generateClientApi>
                    <generateDocs>false</generateDocs>
                    <addGeneratedAnnotation>true</addGeneratedAnnotation>
                    <disableDatesInGeneratedAnnotation>true</disableDatesInGeneratedAnnotation>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>com.marketplace.MarketplaceApplication</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <version>${git-commit-id.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>revision</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <generateGitPropertiesFile>true</generateGitPropertiesFile>
                    <generateGitPropertiesFilename>${project.build.outputDirectory}/git.properties</generateGitPropertiesFilename>
                    <!-- Official javadoc (GitCommitIdMojo.java, saved at scripts/prod-design-docs/):
                         "Specify whether the plugin should fail when a '.git' directory cannot be
                         found. When set to false and no .git directory is found the plugin will
                         skip execution." Railway's DOCKERFILE build sends the source snapshot
                         without .git (build log: ".git directory is not found!"), so the deploy
                         build of 9dbbbb5 failed at marketplace-app. With false: builds without
                         .git (Railway) skip git.properties gracefully — /actuator/info keeps the
                         build section (spring-boot build-info needs no .git); builds with .git
                         (local, GitHub CI) are unchanged. -->
                    <failOnNoGitDirectory>false</failOnNoGitDirectory>
                    <!-- Same doc, failOnUnableToExtractRepoInfo: "Set this to false to continue
                         the build even if unable to get enough data for a complete run. This may
                         be useful during CI builds if the CI server does weird things to the
                         repository." Covers degraded snapshots beyond the plain missing-dir case. -->
                    <failOnUnableToExtractRepoInfo>false</failOnUnableToExtractRepoInfo>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>
        </plugins>
