        </dependency>

        <!-- Spring Modulith -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-actuator</artifactId>
        </dependency>
        <!-- spring-modulith-observability-core is NOT removed in 2.1.1 (measured:
             it exists on Maven Central, HTTP 200, and the 2.1.1 "Production-ready
             Features" reference documents it) — the earlier "removed in Modulith
             2.1" note below this line was factually wrong. It is deliberately NOT
             declared here: D.1's incomplete-publication monitoring rides the
             health contributor + the modulith actuator (both official channels,
             both present), and the observability artifact's module-API span
             aspect + module.events.published counters overlap the house's own
             Micrometer Observation discipline (@Observed pins guarded by
             ObservationCoverageFilesTest) — adding it is an owner decision, not
             a per-unit one. -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-events-jpa</artifactId>
        </dependency>
        <!-- D.3 (compliance plan wave D — «استحداث الأحداث خارجياً عند الحاجة»,
             Modulith events.html "Externalizing Events"): the official Kafka
             externalization artifact (runtime scope — the documented recipe;
             version from the Modulith BOM). The measured activation facts
             (spring-modulith-events-kafka 2.1.1 bytecode): the transport's
             auto-configuration is @ConditionalOnClass(KafkaTemplate) +
             @ConditionalOnProperty(spring.modulith.events.externalization.enabled,
             havingValue="true", matchIfMissing=true) — and the SELECTION gate
             is the @Externalized annotation itself: only event types carrying
             it route to the broker. Zero production event types are annotated
             today (no external consumer exists — the item's own "عند الحاجة"
             condition), so the capability rides fully inert until the owner
             annotates the externally-consumed events and provisions a broker
             (spring.kafka.*): activation is then configuration, not code —
             the platform's "change from the console, not the code" posture.
             The registry guards broker delivery (events.html: publications
             resubmittable through the registry APIs — the A-13 machinery),
             and the end-to-end official path is proven by
             EventExternalizationKafkaIntegrationTest (CI judge). -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-events-kafka</artifactId>
            <scope>runtime</scope>
        </dependency>

