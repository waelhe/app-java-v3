<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.marketplace</groupId>
        <artifactId>marketplace-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>marketplace-ai</artifactId>
    <name>marketplace-ai</name>
    <description>AI chat-client foundation — provider-neutral wiring over Spring AI (google-genai + deepseek starters behind the spring.ai.model.chat selector); no business surface yet</description>

    <dependencies>
        <dependency><groupId>com.marketplace</groupId><artifactId>marketplace-shared</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter</artifactId></dependency>
        <dependency><groupId>org.springframework.modulith</groupId><artifactId>spring-modulith-api</artifactId></dependency>
        <!-- Spring AI provider starters (versions from the spring-ai-bom,
             exception #13 in the root pom). Both stay on the classpath and
             exactly one provider autoconfigures, selected by
             spring.ai.model.chat (google-genai | deepseek | none) — the
             documented multi-model selector (reference 2.0.1:
             api/chat/google-genai-chat.html + api/chat/deepseek-chat.html,
             "Chat Properties"). Provider choice is a deployment decision,
             not a code decision. -->
        <dependency><groupId>org.springframework.ai</groupId><artifactId>spring-ai-starter-model-google-genai</artifactId></dependency>
        <dependency><groupId>org.springframework.ai</groupId><artifactId>spring-ai-starter-model-deepseek</artifactId></dependency>

        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    </dependencies>
</project>
