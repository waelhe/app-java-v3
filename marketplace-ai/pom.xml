<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.marketplace</groupId>
        <artifactId>marketplace-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>marketplace-ai</artifactId>
    <name>marketplace-ai</name>
    <description>Provider-neutral AI capabilities using Spring AI auto-configuration</description>
    <dependencies>
        <dependency><groupId>com.marketplace</groupId><artifactId>marketplace-shared</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter</artifactId></dependency>
        <dependency><groupId>org.springframework.modulith</groupId><artifactId>spring-modulith-api</artifactId></dependency>
        <!-- D.4's surviving half (union 2026-10-08): the annotation
             artifact carrying @CircuitBreaker for the AI chat crossing
             (the exact artifact the Resilience4j reference's annotation
             module documents; version from the resilience4j-bom, root pom
             exception #3). This module rides marketplace-shared only, so
             the annotations artifact joins here explicitly. The runtime
             registries + aspects stay the app classpath's (platform-infra)
             — this is a compile-symbols declaration only. -->
        <dependency><groupId>io.github.resilience4j</groupId><artifactId>resilience4j-annotations</artifactId></dependency>
        <dependency><groupId>org.springframework.modulith</groupId><artifactId>spring-modulith-events-api</artifactId></dependency>
        <dependency><groupId>org.springframework.ai</groupId><artifactId>spring-ai-starter-model-google-genai</artifactId></dependency>
        <dependency><groupId>org.springframework.ai</groupId><artifactId>spring-ai-starter-model-google-genai-embedding</artifactId></dependency>
        <dependency><groupId>org.springframework.ai</groupId><artifactId>spring-ai-starter-model-deepseek</artifactId></dependency>
        <!-- Official Spring AI Community session JDBC starter: complete, tool-call-safe history. -->
        <dependency><groupId>org.springaicommunity</groupId><artifactId>spring-ai-starter-session-jdbc</artifactId></dependency>
        <!-- Official Spring AI Community TypeSafe AI System One (Jev) client. The separate typesafe profile supplies its key. -->
        <dependency><groupId>org.springaicommunity</groupId><artifactId>spring-ai-starter-typesafe</artifactId></dependency>
        <!-- Official TypeSafe integrations on Spring AI SPIs: judge, advisors, RAG processing and tool selection. -->
        <dependency><groupId>org.springaicommunity</groupId><artifactId>typesafe-spring-ai</artifactId></dependency>
        <!-- The upstream TypeSafe POM deliberately marks these SPIs optional; this module already owns RAG and tool capabilities. -->
        <dependency><groupId>org.springframework.ai</groupId><artifactId>spring-ai-rag</artifactId></dependency>
        <dependency><groupId>org.springframework.ai</groupId><artifactId>spring-ai-starter-tool-search-advisor</artifactId></dependency>
        <dependency><groupId>org.springframework.ai</groupId><artifactId>spring-ai-vector-store-advisor</artifactId></dependency>
        <dependency><groupId>org.springframework.ai</groupId><artifactId>spring-ai-starter-vector-store-pgvector</artifactId></dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
