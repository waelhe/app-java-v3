"""
 One source record rendered as an exploratory card — never a content
 copy. state is String DELIBERATELY: the lifecycle vocabulary is
 per-source-type heterogeneous (LOST_FOUND posts carry
 ACTIVE/RESOLVED/FOUND, events ACTIVE/CANCELLED/POSTPONED, jobs OPEN,
 listings ACTIVE/INACTIVE — and the urgent-alert cards carry none at
 all, measured from the assembler: the alert mapping passes null) — a
 single enum would lie about one shared vocabulary that does not
 exist; String is the honest type for the heterogeneous per-source
 state, exactly as the shared DiscoveryCardView carries it. updatedAt
 is the ISO-8601 instant (java.time.Instant.toString) — the GraphQL
 spec has no temporal scalar and this surface adds none (zero new
 dependencies on the locked Boot 4.1.1 → spring-graphql 2.0.5 →
 graphql-java 25.0 chain; a typed DateTime scalar stays a deliberate
 future decision behind a measured need, never a silent drift — the
 same discipline that keeps every version in this tree pinned).
 scopeLocationId is null for user-scoped sources; paid is null for
 organic (the disclosure contract: null never masquerades as either
 answer, AC-20-08); reason carries the human-explainable appearance
 reason (never empty on the FOR_YOU rail, AC-20-06/AC-20-11).
"""
type DiscoveryCard {
  paid: Boolean
  reason: String
  scopeLocationId: ID
  snippet: String
  sourceId: ID!
  sourceType: DiscoverySource!
  state: String
  title: String!
  updatedAt: String!
}

"""
 =====================================================================
 Phase 6 — the first composite journey's projection types (the
 corrected plan §11-Phase-6 + the inventory #599 §7 stage 4). Every
 type below is a BOUNDED READ PROJECTION of an owning module's
 contract (the plan's own words: "add bounded read projections") —
 the GraphQL surface owns no business rule (REST and GraphQL invoke
 the same use cases through the same declared SPIs, #599 §8).
 =====================================================================
 One discovery rail as rendered — the discovery projection's own
 contract (Wave D-1): the rail, its eligible cards (deduped by the
 (sourceType, sourceId) pair, bounded at the assembler's home card
 limit), and the source-side total so "عرض الكل" (the REST topic
 page, UJ-261) can state the real size before the user commits to
 navigating. totalEligible is a scoped per-rail count — Int's signed
 32-bit ceiling (2,147,483,647) is the documented bound, the exact
 priceCents house pattern.
"""
type DiscoveryRow {
  cards: [DiscoveryCard!]!
  row: DiscoveryRail!
  totalEligible: Int!
}

"""
 ---------------------------------------------------------------------
 The bounded Group projection — see the block comment above for the
 closure policy. id is the typed global ID over the owner's
 deterministic per-role native handle; name is the platform role's
 display name; permissions is the server-enforced capability rendering
 (SaleorPermissionCatalog — the platform RBAC rendered in Saleor's
 permission vocabulary, the divergence-registry RBAC row); userCanManage
 is the honest manage-right fact (true exactly for the ADMIN caller —
 the only caller the ADMIN-enforced roots admit).
 ---------------------------------------------------------------------
"""
type Group {
  "The ID of the group — typed global ID (opaque, never a raw UUID)."
  id: ID!
  "The name of the group (the platform role's display name)."
  name: String!
  "List of group permissions (the granted permission codes)."
  permissions: [Permission!]
  """
  True, if the currently authenticated user has rights to manage a group
  (the platform ADMIN capability — the same right the role grant/revoke
  commands gate).
  """
  userCanManage: Boolean!
}

"""
 Saleor's connection envelope for countable group lists — declared (not
 runtime-generated) so the exact Saleor shape stands, including
 totalCount. Spring's ConnectionTypeDefinitionConfigurer skips
 already-declared connection types (the measured declared-types-skip
 behavior the UserCountableConnection declaration recorded), so this
 declaration wins and the generated connections elsewhere are untouched.
 pageInfo reuses the EXISTING shared PageInfo type — not redeclared.
"""
type GroupCountableConnection {
  edges: [GroupCountableEdge!]!
  "Pagination data for this connection."
  pageInfo: PageInfo!
  "A total count of items in the collection."
  totalCount: Int
}

type GroupCountableEdge {
  "A cursor for use in pagination (the row's keyset sort key)."
  cursor: String!
  "The item at the end of the edge."
  node: Group!
}

type LanguageDisplay {
  "ISO 639 representation of the language name."
  code: LanguageCodeEnum!
  "Full name of the language."
  language: String!
}

"""
 Saleor's navigation menu tree. Items form a forest rooted at the menu with
 the platform's cycle-guarded move semantics.
"""
type Menu {
  id: ID!
  items: [MenuItem!]!
  name: String!
  slug: String!
}

type MenuBulkDelete {
  count: Int!
  errors: [MenuError!]!
  menuErrors: [MenuError!]! @deprecated(reason : "Use `errors` field instead.")
}

type MenuCountableConnection {
  edges: [MenuCountableEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

type MenuCountableEdge {
  cursor: String!
  node: Menu!
}

type MenuCreate {
  errors: [MenuError!]!
  menu: Menu
  menuErrors: [MenuError!]! @deprecated(reason : "Use `errors` field instead.")
}

type MenuDelete {
  errors: [MenuError!]!
  menu: Menu
  menuErrors: [MenuError!]! @deprecated(reason : "Use `errors` field instead.")
}

type MenuError {
  code: MenuErrorCode!
  field: String
  menuItems: [ID!]
  message: String
}

type MenuItem {
  category: Category
  children: [MenuItem!]
  id: ID!
  level: Int!
  menu: Menu!
  name: String!
  page: Page
  parent: MenuItem
  translation(languageCode: LanguageCodeEnum!): MenuItemTranslation
  url: String
}

type MenuItemBulkDelete {
  count: Int!
  errors: [MenuError!]!
  menuErrors: [MenuError!]! @deprecated(reason : "Use `errors` field instead.")
}

type MenuItemCountableConnection {
  edges: [MenuItemCountableEdge!]!
  pageInfo: PageInfo!
  totalCount: Int
}

type MenuItemCountableEdge {
  cursor: String!
  node: MenuItem!
}

type MenuItemCreate {
  errors: [MenuError!]!
  menuErrors: [MenuError!]! @deprecated(reason : "Use `errors` field instead.")
  menuItem: MenuItem
}

type MenuItemDelete {
  errors: [MenuError!]!
  menuErrors: [MenuError!]! @deprecated(reason : "Use `errors` field instead.")
  menuItem: MenuItem
}

type MenuItemMove {
  errors: [MenuError!]!
  menu: Menu
  menuErrors: [MenuError!]! @deprecated(reason : "Use `errors` field instead.")
}

type MenuItemTranslate {
  errors: [MenuError!]!
  menuErrors: [MenuError!]! @deprecated(reason : "Use `errors` field instead.")
  menuItem: MenuItem
}

type MenuItemTranslation {
  id: ID!
  language: LanguageCodeEnum!
  name: String!
}

type MenuItemUpdate {
  errors: [MenuError!]!
  menuErrors: [MenuError!]! @deprecated(reason : "Use `errors` field instead.")
  menuItem: MenuItem
}

type MenuUpdate {
  errors: [MenuError!]!
  menu: Menu
  menuErrors: [MenuError!]! @deprecated(reason : "Use `errors` field instead.")
}

type Mutation {
  accountAddressCreate(customerId: ID, input: AddressInput!, type: AddressTypeEnum): AccountAddressCreate
  accountAddressDelete(id: ID!): AccountAddressDelete
  accountAddressUpdate(id: ID!, input: AddressInput!): AccountAddressUpdate
