    input: AttributeValueCreateInput!
  ): AttributeValueCreate
  "Deletes a value of an attribute."
  attributeValueDelete(
    """
    External ID of an attribute value to delete. No external-ID
    column exists on this platform (the recorded divergence); a
    non-null value answers the classified validation error.
    """
    externalReference: String,
    "ID of an attribute value to delete."
    id: ID
  ): AttributeValueDelete
  "Updates an attribute value's translation for the addressed language dimension."
  attributeValueTranslate(
    "AttributeValue ID or AttributeValueTranslatableContent ID."
    id: ID!,
    """
