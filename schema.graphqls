"""
 The bounded User projection — see the block comment above for the
 closure policy. id is the typed global ID; isStaff is the platform's
 staff concept (the ADMIN role); isActive is the honest login-identity
 fact the owner owns today (a pseudonymized account is not active);
 userPermissions is the server-enforced capability mapping
 (SaleorPermissionCatalog — the platform RBAC rendered in Saleor's
 permission vocabulary, the divergence-registry RBAC row).
"""
type User {
  addresses: [Address!]
  "The date and time when the account was created (ISO-8601)."
  dateJoined: String
  defaultBillingAddress: Address
  defaultShippingAddress: Address
  "The email address of the user (null when the account has none)."
  email: String
  "The ID of the user — typed global ID (opaque, never a raw UUID)."
  id: ID!
  "Determine if the user is active (a live login identity exists)."
  isActive: Boolean!
  "Determine if the user is a staff admin (the platform ADMIN role)."
  isStaff: Boolean!
  "The account's effective server-side permissions."
  userPermissions: [UserPermission!]!
}

type UserBulkSetActive {
  accountErrors: [AccountError!]! @deprecated(reason : "Use `errors` field instead.")
  count: Int!
  errors: [AccountError!]!
}

"""
 Saleor's connection envelope for countable user lists — declared
 (not runtime-generated) so the exact Saleor shape stands, including
 totalCount. Spring's ConnectionTypeDefinitionConfigurer skips
 already-declared connection types (measured in the 2.0.5 source —
 the getTypeOrNull filter), so this declaration wins and the generated
 connections elsewhere are untouched.
"""
type UserCountableConnection {
  edges: [UserCountableEdge!]!
  "Pagination data for this connection."
  pageInfo: PageInfo!
  "A total count of items in the collection."
  totalCount: Int
}

type UserCountableEdge {
  "A cursor for use in pagination (the row's keyset sort key)."
  cursor: String!
  "The item at the end of the edge."
  node: User!
}

"""
 Saleor's UserPermission shape (minus sourcePermissionGroups — the
 permission-group workbench is a later P1 slice with no owning model
 yet; the absence is recorded, not faked).
"""
type UserPermission {
  "Internal code for permission."
  code: PermissionEnum!
  "Describe action(s) allowed to do by permission."
  name: String!
}

type VerifyToken {
  accountErrors: [AccountError!]! @deprecated(reason : "Use `errors` field instead.")
  errors: [AccountError!]!
  isValid: Boolean!
  payload: String
  user: User
}

"""
 ---------------------------------------------------------------------
 The bounded Voucher projection — see the block comment above for
 the closure policy. id is the typed global ID over the native
 vouchers key; used is the redemption-row count (the owner's own
 accounting seam); applyOncePerCustomer is the truthful flattening of
 the per-user limit (true exactly when the limit is 1); the window
 instants are ISO-8601 strings, both OPTIONAL on the platform (the
 registered nullability divergence).
 ---------------------------------------------------------------------
"""
type Voucher {
  "Determine if the voucher usage should be limited to one use per customer (the row's per-user limit == 1; a limit of N>1 or unlimited renders false)."
  applyOncePerCustomer: Boolean!
  "The code of the voucher (the row's normalized uppercase code)."
  code: String
  "Currency code for voucher (the policy row's own ISO-4217 denomination)."
  currency: String
  "Determines a type of discount for voucher - value or percentage."
  discountValueType: DiscountValueTypeEnum!
  "The end date and time of voucher (ISO-8601; null when the policy row has no end)."
  endDate: String
  "The ID of the voucher — typed global ID (opaque, never a raw UUID)."
  id: ID!
  "The name of the voucher (null when the policy row carries none)."
  name: String
  "The start date and time of voucher (ISO-8601; null when the policy row opens an unbounded window)."
  startDate: String
  "The number of times a voucher can be used (the row's global redemption limit; null = unlimited)."
  usageLimit: Int
  "Usage count of the voucher (redemption rows counted — never a stored counter)."
  used: Int!
}

type VoucherBulkDelete {
  "Returns how many objects were affected."
  count: Int!
  errors: [DiscountError!]!
}

"""
 Saleor's connection envelope for countable voucher lists — same
 declared-not-generated rule as PromotionCountableConnection above;
 pageInfo reuses the EXISTING shared PageInfo type — not redeclared.
"""
type VoucherCountableConnection {
  edges: [VoucherCountableEdge!]!
  "Pagination data for this connection."
  pageInfo: PageInfo!
  "A total count of items in the collection."
  totalCount: Int
}

type VoucherCountableEdge {
  "A cursor for use in pagination (the row's keyset sort key)."
  cursor: String!
  "The item at the end of the edge."
  node: Voucher!
}

type VoucherCreate {
  errors: [DiscountError!]!
  voucher: Voucher
}

type VoucherDelete {
  errors: [DiscountError!]!
  voucher: Voucher
}

type VoucherUpdate {
  errors: [DiscountError!]!
  voucher: Voucher
}

