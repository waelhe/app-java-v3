  voucherDelete(
    """
    External ID of a voucher to delete. No external-ID column exists
    on this platform; a non-null value answers the classified
    validation error.
    """
    externalReference: String,
    "ID of a voucher to delete."
    id: ID
  ): VoucherDelete
  "Updates a voucher."
  voucherUpdate(
    """
    External ID of a voucher to update. No external-ID column exists
    on this platform; a non-null value answers the classified
    validation error.
    """
    externalReference: String,
    "ID of a voucher to update."
    id: ID,
    "Fields required to update a voucher."
    input: VoucherInput!
  ): VoucherUpdate
}

