<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.marketplace</groupId>
        <artifactId>marketplace-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>marketplace-realestate</artifactId>
    <name>marketplace-realestate</name>
    <description>Real-estate vertical fields on provider listings — the media-module pattern (realestate systems plan L31)</description>

    <dependencies>
        <!-- OpenAPI annotation vocabulary for the springdoc-generated public
             client contract (L29 pattern, root-managed version). -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
        </dependency>
        <dependency><groupId>com.marketplace</groupId><artifactId>marketplace-shared</artifactId></dependency>
        <dependency><groupId>com.marketplace</groupId><artifactId>marketplace-platform-infra</artifactId></dependency>
        <!-- The ACTIVE-listing read gate of the public property surface: the
             named-interface dependency pattern (the app/admin module's own
             shape — com.marketplace.admin depends on "catalog :: catalog-spi"
             the same way). No internals are touched, only the SPI. -->
        <dependency><groupId>com.marketplace</groupId><artifactId>marketplace-catalog</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
        <dependency><groupId>org.springframework.modulith</groupId><artifactId>spring-modulith-api</artifactId></dependency>
        <dependency><groupId>org.springframework.data</groupId><artifactId>spring-data-envers</artifactId></dependency>

        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.instancio</groupId><artifactId>instancio-junit</artifactId><scope>test</scope></dependency>
    </dependencies>
</project>
