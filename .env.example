# ─────────────────────────────────────────────────────────────
# Marketplace Backend — Environment Variables Template
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your real values:
#   cp .env.example .env
#
# NEVER commit the real `.env` file to git. It is gitignored.
#
# See docs/external-services.md for setup instructions for each service,
# including official documentation links.
# ─────────────────────────────────────────────────────────────

# ─── PostgreSQL (primary database) ──────────────────────────
# Local dev default; change for staging/prod.
# Reference: https://docs.spring.io/spring-boot/how-to/data-initialization.html
DB_URL=jdbc:postgresql://localhost:5432/marketplace
DB_USERNAME=marketplace
DB_PASSWORD=change_me

# ─── Redis (cache + sessions + rate limiting) ───────────────
# Reference: https://docs.spring.io/spring-boot/reference/data/nosql.html#data.nosql.redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── SMTP (transactional email) ─────────────────────────────
# Dev: use MailHog (localhost:1025, no auth).
# Prod: use Amazon SES, SendGrid, or similar (port 587, STARTTLS).
# Reference: https://docs.spring.io/spring-boot/reference/io/email.html
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# ─── GitHub OAuth2 (social login) ───────────────────────────
# Create at: https://github.com/settings/developers
# Callback URL: https://<host>/login/oauth2/code/github
# Reference: https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/creating-an-oauth-app
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Google OAuth2 (social login) ───────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Redirect URI: https://<host>/login/oauth2/code/google
# Reference: https://support.google.com/cloud/answer/6158849
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── JWT signing keystore ───────────────────────────────────
# Generate with keytool (see docs/external-services.md §6.1).
# Reference: https://docs.spring.io/spring-security/reference/servlet/oauth2/server-authorization/jwk.html
JWT_KEYSTORE_PATH=/opt/marketplace/keystore.jks
JWT_KEYSTORE_PASSWORD=change_me
JWT_KEY_ALIAS=marketplace-auth
JWT_KEY_PASSWORD=change_me
AUTH_SERVER_ISSUER=http://localhost:8080

# ─── CORS (allowed frontend origins) ────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Dev-only seed data (dev profile only — NOT for prod) ───
# Used by DevDataInitializer to seed an admin user + OAuth2 client.
# @Profile("dev") + @ConditionalOnProperty(matchIfMissing=false)
# Reference: see marketplace-identity DevDataInitializer
DEV_ADMIN_PASSWORD=change_me
DEV_CLIENT_SECRET=change_me
OAUTH2_REDIRECT_URI=http://127.0.0.1:3000/login/oauth2/code/marketplace-web-client
