{
  "schemaVersion": 1,
  "description": "Trusted CodeRabbit alternative-evidence allowlist. This file is read from the trusted main commit, never from the candidate.",
  "checks": {
    "Dependency Review (PR dependency changes)": {
      "appSlugs": [
        "github-actions"
      ],
      "pathPatterns": [
        "package-lock.json",
        "**/package-lock.json",
        "npm-shrinkwrap.json",
        "**/npm-shrinkwrap.json",
        "yarn.lock",
        "**/yarn.lock",
        "pnpm-lock.yaml",
        "**/pnpm-lock.yaml",
        "gradle.lockfile",
        "**/gradle.lockfile",
        "libs.versions.toml",
        "**/libs.versions.toml"
      ],
      "workflowPath": ".github/workflows/ci.yml",
      "events": [
        "pull_request"
      ]
    }
  }
}
