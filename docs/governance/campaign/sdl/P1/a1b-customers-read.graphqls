# =====================================================================
# Saleor Users domain — P1 wave, packet campaign-b3-a1b (A1 identity
# agent): the customers read root (the canonical plan §5-P1: "retained
# Dashboard user/profile and permission operations using existing
# identity and console owners").
# PROPOSAL to A0 (the one SDL steward): the Query field below appends to
# the shared root type Query; every other declaration in this fragment
# is a PURE ADDITION — no existing shared type is redeclared (PageInfo,
# PermissionEnum, OrderDirection, User, UserCountableConnection,
# UserCountableEdge, UserPermission, StaffUserInput, StaffMemberStatus,
# UserSortingInput and UserSortField keep their existing declarations —
# the customers root REUSES the whole existing User family).
# Root name, argument names/types/nullability and the connection
# envelope are the pinned Saleor 3.23.43 wire contract
# (saleor/graphql/schema.graphql, blob b8fa0dd8 — the measured root at
# schema line 1578: customers(filter, where, sortBy, search, before,
# after, first, last): UserCountableConnection, including the pinned
# schema's own @deprecated on the legacy filter argument); the
# platform's identity owner remains the single source of truth behind
# the root. The GLOBAL IDs on this surface are the typed Relay-style
# codec's (SaleorGlobalIdCodec): opaque base64("User:<uuid>") values —
# never raw UUIDs (the same wire identity the staffUsers root emits:
# one User type, one codec).
#
# The bounded projection rationale (the honest method the User read
# slice established): the platform's customer population IS the single
# identity store's customer-account slice — the accounts whose primary
# role is CONSUMER (the closed UserRole vocabulary's own customer/
# consumer concept, the V187 CHECK's own list) — the complementary
# population the staffUsers roster reads over the SAME store (the
# packet's ADAPT disposition: no duplicate identity store, staff
# accounts excluded by the population's own scoping). The connection
# envelope is the EXISTING declared UserCountableConnection (edges/
# pageInfo/totalCount — byte-shape from the pinned schema); the node
# projection is the EXISTING bounded User type.
#
# The two genuinely new input types are PLATFORM-SHAPED bounded
# declarations of the pinned Saleor filter inputs (the StaffUserInput
# precedent: the declared wire shape of a declared-but-unexecuted
# argument). ONLY fields whose types are already shared vocabulary are
# declared; the undeclared fields of Saleor's full closure, each with
# its reason (a declared-but-fake field would be the violation, not the
# absence):
#   CustomerFilterInput (Saleor closure: dateJoined, numberOfOrders,
#   placedOrders, search, metadata, ids, updatedAt):
#   - search and ids: declared (String / [ID!] — the bounded shape).
#   - dateJoined / placedOrders / updatedAt: UNDECLARED — the
#     DateRangeInput/DateTimeRangeInput range family has no shared
#     declaration and no owning query capability yet; declared when that
#     owner lands with its tests.
#   - numberOfOrders: UNDECLARED — belongs to the orders owner (a later
#     wave; the identity owner owns no order count).
#   - metadata: UNDECLARED — the platform owns no metadata store.
#   CustomerWhereInput (Saleor closure: metadata, ids, email,
#   firstName, lastName, isActive, dateJoined, updatedAt,
#   placedOrdersAt, addresses, numberOfOrders, customerType,
#   attributes, AND/OR/NOT):
#   - ids and isActive: declared ([ID!] / Boolean — facts the users row
#     owns; the bounded shape).
#   - email / firstName / lastName: UNDECLARED — the StringFilterInput
#     family has no shared declaration, and firstName/lastName have no
#     owning columns at all (the User closure's own recorded absence).
#   - dateJoined / updatedAt / placedOrdersAt: UNDECLARED — the
#     DateTimeRangeInput range family (see above).
#   - numberOfOrders: UNDECLARED — the orders owner (later wave).
#   - addresses: UNDECLARED — the platform owns no address store.
#   - customerType: UNDECLARED — the platform owns no customer-type
#     store (Saleor 3.23's own late addition; PENDING owner decision).
#   - attributes: UNDECLARED — the platform owns no customer-attribute
#     store.
#   - metadata: UNDECLARED — no metadata store.
#   - AND / OR / NOT: UNDECLARED — the boolean composition family rides
#     the same not-implemented boundary (no composed condition can
#     execute before the leaf fields do).
# The declared-but-unexecuted root arguments (filter, where, search,
# before, last — every field combination of the two inputs included)
# answer explicit classified IllegalArgumentExceptions at runtime (VAL-
# 001 through the house resolver) — the staffUsers filter/before/last
# precedent — never a silent no-op, never fake success. The sort
# vocabulary is Saleor's full UserSortField enum (the EXISTING shared
# declaration): the fields with an owning indexed column (EMAIL/
# CREATED_AT/LAST_MODIFIED_AT) execute as real keyset sorts, the rest
# answer the same explicit error. The root requires
# MANAGE_ORDERS/MANAGE_USERS on Saleor (the pinned schema's own
# requirement) — enforced server-side as the platform's ADMIN capability
# at the identity use-case boundary (the RBAC mapping registry row),
# never as a UI route guard.
# =====================================================================

# ---------------------------------------------------------------------
# Query additions (append to the shared root type Query)
# ---------------------------------------------------------------------
type Query {
    # "List of the shop's customers. This list includes all users who
    # registered through the accountRegister mutation." — the Saleor
    # customer list with its countable-connection envelope (edges/
    # pageInfo/totalCount, byte-shape from the pinned schema). On this
    # platform the population is the single identity store's
    # customer-account slice (the CONSUMER primary role — the closed
    # vocabulary's customer/consumer concept), the complementary
    # population of the SAME store the staffUsers roster reads.
    # FORWARD-ONLY keyset paging on this first slice: first/after ride
    # the platform's ScrollPosition keyset contract (the staffUsers/
    # permissionGroups precedent — cursors identify a row's sort key
    # (email|createdAt|updatedAt, id), never an absolute offset);
    # before/last stay declared (the exact Saleor argument shape) but
    # answer an explicit classified error until a backward scroll
    # exists — a recorded, tested boundary, not a silent no-op. filter
    # (deprecated upstream in favor of where — the pinned schema's own
    # directive kept), where and search are likewise the declared wire
    # shape with explicit not-yet-supported errors. Sort vocabulary is
    # the EXISTING shared UserSortField enum: the owned subset executes
    # as real keyset sorts, the rest answer the same explicit error.
    # MANAGE_ORDERS/MANAGE_USERS on Saleor → ADMIN here (the owning
    # identity use case's gate).
    customers(
    """Filtering options for customers."""
    filter: CustomerFilterInput @deprecated(reason: "Use `where` filter instead.")

    """Where filtering options for customers."""
    where: CustomerWhereInput

    """Sort customers."""
    sortBy: UserSortingInput

    """Search customers."""
    search: String

    """Return the elements in the list that come before the specified cursor."""
    before: String

    """Return the elements in the list that come after the specified cursor."""
    after: String

    """Retrieve the first n elements from the list."""
    first: Int

    """Retrieve the last n elements from the list."""
    last: Int
): UserCountableConnection
}

# ---------------------------------------------------------------------
# The bounded customer filter inputs — the platform-shaped declarations
# of the pinned Saleor filter arguments (see the block comment above
# for every undeclared field's reason). Declared-but-unexecuted wire
# shapes: ANY non-null filter/where value answers the explicit
# classified not-implemented error at runtime — the StaffUserInput
# precedent.
# ---------------------------------------------------------------------
input CustomerFilterInput {
    search: String
    ids: [ID!]
}

input CustomerWhereInput {
    ids: [ID!]
    isActive: Boolean
}
