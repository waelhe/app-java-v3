# === Campaign packet campaign-b4-c: the Saleor products read roots ===
# "List of the shop's products." — the store's product population (the
# authoritative products root the legacy platform roots read — never a
# duplicate store) with its countable-connection envelope (edges/
# pageInfo/totalCount, byte-shape from the pinned schema). These are
# Saleor PUBLIC storefront roots whose include-unpublished variant
# requires MANAGE_ORDERS/MANAGE_DISCOUNTS/MANAGE_PRODUCTS — mapped
# through the platform's ADMIN capability (the SaleorPermissionCatalog
# contract): the public population is the ACTIVE display-lifecycle
# slice; an ADMIN caller's scroll and lookup widen to every state —
# the registered permission-aware population mapping. FORWARD-ONLY
# keyset paging on this first slice: first/after ride the platform's
# REAL SQL keyset scroll (the staffUsers repository-keyset precedent —
# cursors identify a row's sort key (name, id), never an absolute
# offset); before/last stay declared (the exact Saleor argument shape)
# but answer an explicit classified error until a backward scroll
# exists — a recorded, tested boundary, not a silent no-op. filter
# (deprecated upstream), where, search and channel (no channel model —
# the PENDING-ADR commercial-context row) are likewise the declared
# wire shapes with explicit not-yet-supported errors. The sort
# vocabulary is Saleor's own ProductOrderField enum: NAME (the
# product's own title column) executes as the real keyset sort,
# deterministic with the id tiebreaker; the attributeId sort leg and
# the other thirteen fields answer the explicit not-implemented error.
# The read roots — valid GraphQL SDL requires root fields to live inside a
# type Query block (the code-review fix; field signatures, arguments,
# docstrings and ordering unchanged).
type Query {
products(
"""Filtering options for products."""
filter: ProductFilterInput @deprecated(reason: "Use `where` filter instead.")

"""Where filtering options for products."""
where: ProductWhereInput

"""Sort products."""
sortBy: ProductOrder

"""Search products."""
search: String

"""Slug of a channel for which the data should be returned."""
channel: String

"""Return the elements in the list that come before the specified cursor."""
before: String

"""Return the elements in the list that come after the specified cursor."""
after: String

"""Retrieve the first n elements from the list."""
first: Int

"""Retrieve the last n elements from the list."""
last: Int
): ProductCountableConnection

# "Look up a product by ID, slug, slug language code, external reference or channel." —
# the storefront lookup over the owning use case's permission-aware
# readable population: an unknown but well-formed id answers null; a
# KNOWN but unpublished row (SUSPENDED/ARCHIVED/DRAFT) answers null
# for non-ADMIN callers — the data-scope boundary the owning use case
# enforces, never an error and never a leak. id executes through the
# typed global-ID codec (a malformed or mistyped global ID answers the
# codec's classified validation error — never a raw UUID fallback).
# slug (no slug column), slugLanguageCode (no translation owner),
# externalReference (no external-ID column) and channel (no channel
# model) answer the explicit classified error whenever they are sent;
# a keyless call answers the classified validation error (the recorded
# divergence from upstream's null answer).
product(
"""ID of the product."""
id: ID

"""Slug of the product (no slug column on this platform — an explicit classified error)."""
slug: String

"""Slug language code (no translation owner — an explicit classified error)."""
slugLanguageCode: LanguageCodeEnum

"""External ID of the product (no external-ID column — an explicit classified error)."""
externalReference: String

"""Slug of a channel for which the data should be returned (no channel model — an explicit classified error)."""
channel: String
): Product
}


# === Campaign packet campaign-b4-c: bounded type declarations (integrated in-branch by A0 — the sequential single-writer flow) ===
# ---------------------------------------------------------------------
# The bounded Product projection — see the block comment above for
# the closure policy. id is the typed global ID over the native
# products key; name is the product's own display title; productType
# renders the optional reusable-goods-schema reference as the typed
# global ID of the EXISTING ProductType root's type (the campaign-b2-
# a2 slice's own wire type — one codec, one ID vocabulary); status is
# a PLATFORM EXTENSION fact the entity owns and the Saleor wire shape
# does not carry (the display lifecycle ACTIVE/SUSPENDED/ARCHIVED/
# DRAFT), preserved per the governing matrix's own "platform-only
# fields as extensions" policy. Unowned Saleor fields stay undeclared
# with reasons: the metadata family (no metadata store), seoTitle/
# seoDescription (no owning columns), description/descriptionJson
# (rich-text JSON — no owning rich-text capability and no JSONString
# scalar), slug (no slug column), externalReference (no external-ID
# column), updatedAt (no typed DateTime scalar on this surface — the
# house no-new-scalar decision), the pricing connection (money
# surfaces stay off the wire per the frozen money contract — the
# registered Decimal/PositiveDecimal row), chargeTaxes/taxType/
# taxClass-related fields (the tax-class family is BLOCKED_BY_DECISION
# D-TAX-001), variants/defaultVariant/digitalContent/media/attributes
# (the P2 variant/media/attribute-assignment slices' own later facts),
# category (the product's own dictionary is the STORE-categories
# vocabulary — a different legacy store, never conflated with the
# Saleor Category registry), weight/sku/rating (no owning columns)
# and translation (no translation owner).
# ---------------------------------------------------------------------
type Product {
    """The ID of the product — typed global ID (opaque, never a raw UUID)."""
    id: ID!

    """Name of the product (the entity's own display title)."""
    name: String!

    """The product's reusable goods schema, as the typed global ID of the ProductType root's type (null keeps pre-C1 and zero-variant products compatible)."""
    productType: ID

    """The product's display lifecycle state (a platform extension fact: ACTIVE/SUSPENDED/ARCHIVED/DRAFT)."""
    status: String!
}

# Saleor's connection envelope for countable product lists —
# declared (not runtime-generated) so the exact Saleor shape stands,
# including totalCount. Spring's ConnectionTypeDefinitionConfigurer
# skips already-declared connection types (the measured
# declared-types-skip behavior the UserCountableConnection/
# CategoryCountableConnection declarations recorded), so this
# declaration wins and the generated connections elsewhere are
# untouched. pageInfo reuses the EXISTING shared PageInfo type — not
# redeclared.
type ProductCountableConnection {
    """Pagination data for this connection."""
    pageInfo: PageInfo!

    edges: [ProductCountableEdge!]!

    """A total count of items in the collection (the caller-scope population's own count)."""
    totalCount: Int
}

type ProductCountableEdge {
    """The item at the end of the edge."""
    node: Product!

    """A cursor for use in pagination (the row's keyset sort key)."""
    cursor: String!
}

# Saleor's product filter input — the declared wire shape of the
# deprecated filter argument (see products: an explicit classified
# error until the owning query capability exists). BOUNDED closure:
# search/ids/slugs carry the scalar filter surface; the heavy closure
# families (isPublished/publicationDate/channel, productTypes/categories/
# collections/attributes, price ranges, stocks, metadata, the
# hasCategory/hasCollection composition) stay undeclared until owning
# capabilities exist — any filter use answers the classified
# not-implemented error before field-level semantics matter, and a
# Dashboard query naming an undeclared sub-field fails schema
# validation loudly (never a silent no-op).
input ProductFilterInput {
    search: String
    ids: [ID!]
    slugs: [String!]
}

# Saleor's product where input — the declared wire shape of the where
# argument (see products: an explicit classified error until the
# owning query capability exists). BOUNDED closure: ids carry the
# owned scalar facts; every other closure family stays undeclared
# until an owning capability exists — any where use answers the
# classified not-implemented error.
input ProductWhereInput {
    ids: [ID!]
}

# Saleor's product sorting input and field vocabulary — the full
# pinned enum is declared verbatim (fourteen values with upstream's
# own deprecation notes); NAME (the product's own title column)
# executes as the real keyset sort (deterministic with the id
# tiebreaker); the attributeId leg and the other thirteen fields
# answer the explicit not-implemented error. direction reuses the
# EXISTING shared OrderDirection enum — not redeclared.
input ProductOrder {
    """Specifies the direction in which to sort products."""
    direction: OrderDirection!

    """Specifies the channel in which to sort the data (no channel model — an explicit classified error)."""
    channel: String @deprecated(reason: "Use root-level channel argument instead.")

    """Sort product by the selected attribute's values (no attribute sort owner — an explicit classified error)."""
    attributeId: ID

    """Sort products by the selected field."""
    field: ProductOrderField
}

enum ProductOrderField {
    """Sort products by name"""
    NAME

    """Sort products by rank. Note: This option is available only with the `search` filter."""
    RANK

    """
    Sort products by price.

    This option requires a channel filter to work as the values can vary between channels.
    """
    PRICE

    """
    Sort products by a minimal price of a product's variant.

    This option requires a channel filter to work as the values can vary between channels.
    """
    MINIMAL_PRICE

    """Sort products by update date."""
    LAST_MODIFIED @deprecated(reason: "Use `LAST_MODIFIED_AT` instead.")

    """Sort products by update date."""
    DATE @deprecated(reason: "Use `LAST_MODIFIED_AT` instead.")

    """Sort products by type"""
    TYPE

    """
    Sort products by publication status.

    This option requires a channel filter to work as the values can vary between channels.
    """
    PUBLISHED

    """
    Sort products by publication date.

    This option requires a channel filter to work as the values can vary between channels.
    """
    PUBLICATION_DATE @deprecated(reason: "Use `PUBLISHED_AT` instead.")

    """
    Sort products by publication date.

    This option requires a channel filter to work as the values can vary between channels.
    """
    PUBLISHED_AT

    """Sort products by update date"""
    LAST_MODIFIED_AT

    """Sort products by collection. Note: This option is available only for the `Collection.products` query."""
    COLLECTION

    """Sort products by rating"""
    RATING @deprecated(reason: "Product rating is deprecated and will be removed. Use a numeric attribute instead.")

    """Sort products by creation date"""
    CREATED_AT
}
