<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.marketplace</groupId>
    <artifactId>marketplace-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>marketplace-platform</name>
    <description>Two-sided Marketplace Backend — Multi-module Maven + Spring Boot 4 + Spring Modulith</description>

    <modules>
        <module>marketplace-shared</module>
        <module>marketplace-platform-infra</module>
        <module>marketplace-identity</module>
        <module>marketplace-catalog</module>
        <module>marketplace-booking</module>
        <module>marketplace-payments</module>
        <module>marketplace-pricing</module>
        <module>marketplace-reviews</module>
        <module>marketplace-messaging</module>
        <module>marketplace-search</module>
        <module>marketplace-provider</module>
        <module>marketplace-availability</module>
        <module>marketplace-notifications</module>
        <module>marketplace-ledger</module>
        <module>marketplace-disputes</module>
        <module>marketplace-media</module>
        <module>marketplace-app</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <resilience4j.version>2.4.0</resilience4j.version>
        <archunit.version>1.5.0</archunit.version>
        <jacoco.version>0.8.15</jacoco.version>
        <jacoco.coverage.threshold>0.70</jacoco.coverage.threshold>
        <enforcer.fail>true</enforcer.fail>
        <springdoc.version>3.1.0</springdoc.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <instancio.version>6.0.0</instancio.version>
        <git-commit-id.version>10.0.1</git-commit-id.version>
        <!-- Boot 4.1.1 managed versions lag behind transitive dep requirements -->
        <jackson.version>3.2.2</jackson.version>
        <prometheus-client.version>1.8.0</prometheus-client.version>
        <!-- Override: commons-logging — spring-session-core 4.1.1 (Boot 4.1.1) requires 1.4.0, Boot 4.1.1 BOM manages 1.3.6 (RequireUpperBoundDeps) -->
        <commons-logging.version>1.4.0</commons-logging.version>
        <!-- Override: Jackson-2 BOM — swagger-core-jakarta 2.2.52 (springdoc 3.1.0) requires 2.22.0, Boot 4.1.1 manages 2.21.5 (RequireUpperBoundDeps) -->
        <jackson-2-bom.version>2.22.2</jackson-2-bom.version>
        <awssdk.version>2.54.13</awssdk.version>
        <project.build.outputTimestamp>2026-06-14T08:00:00Z</project.build.outputTimestamp>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Exception #1: Spring Modulith BOM — Boot does not manage Modulith -->
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>2.1.1</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Exception #3: Resilience4j BOM — Boot BOM does not manage resilience4j-spring-boot4 -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Exception #4: ArchUnit — test-only, not managed by Boot -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <!-- Exception: commons-lang3 — springdoc pulls 3.20.0, Boot BOM pins 3.19.0 -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>3.20.0</version>
            </dependency>
            <!-- Override: Jackson BOM — spring-security-oauth2-authorization-server 7.1.1 requires jackson-databind 3.2.0, Boot 4.1.1 manages 3.1.5 -->
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Override: Prometheus — micrometer-registry-prometheus 1.17.1 requires 1.7.0, Boot 4.1.1 manages 1.7.0; keep 1.8.0 (latest stable) for CVE coverage -->
            <dependency>
                <groupId>io.prometheus</groupId>
                <artifactId>prometheus-metrics-core</artifactId>
                <version>${prometheus-client.version}</version>
            </dependency>
            <dependency>
                <groupId>io.prometheus</groupId>
                <artifactId>prometheus-metrics-exposition-formats</artifactId>
                <version>${prometheus-client.version}</version>
            </dependency>
            <dependency>
                <groupId>io.prometheus</groupId>
                <artifactId>prometheus-metrics-tracer-common</artifactId>
                <version>${prometheus-client.version}</version>
            </dependency>
            <!-- Exception #7: springdoc-openapi — community OpenAPI auto-generation -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <!-- Exception #8: MapStruct — compile-time code generation for Entity↔DTO mapping -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <!-- Exception #9: Instancio — test data generation -->
            <dependency>
                <groupId>org.instancio</groupId>
                <artifactId>instancio-junit</artifactId>
                <version>${instancio.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- Exception #10: AWS SDK v2 BOM — Boot does not manage the AWS SDK.
                 Consumed only by marketplace-media (S3-compatible presigned channel,
                 roadmap B1 / G-PROD-1). Official evidence cached under
                 scripts/media-doc-verify/: R2 presigned-URL documentation (SDK as the
                 client, region "auto", endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com)
                 + the S3Presigner javadoc from s3-2.54.13-sources.jar + the official
                 BOM listing (480 managed artifacts incl. s3 and url-connection-client). -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${awssdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Internal modules -->
            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>marketplace-shared</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>marketplace-platform-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>marketplace-identity</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>marketplace-catalog</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>marketplace-booking</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>marketplace-payments</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>marketplace-pricing</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>marketplace-reviews</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>marketplace-messaging</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>marketplace-search</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>marketplace-provider</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>marketplace-availability</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>marketplace-notifications</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>marketplace-ledger</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>marketplace-disputes</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.marketplace</groupId>
                <artifactId>marketplace-media</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Release channel: GitHub Packages. The server id "github" matches
         setup-java's server-id in .github/workflows/maven-publish.yml, which
         writes the authenticated server entry (GITHUB_ACTOR / GITHUB_TOKEN)
         into settings.xml at release-build time. Inert for normal builds —
         only `mvn deploy` reads it. Guard-pinned by PlatformGovernanceFilesTest. -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/waelhe/app-java-v3</url>
        </repository>
    </distributionManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-dependency-convergence</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <dependencyConvergence/>
                                <requireUpperBoundDeps/>
                                <banDuplicatePomDependencyVersions/>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                            </rules>
                            <fail>${enforcer.fail}</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <exclude>**/*Application.*</exclude>
                        <exclude>**/*Config.*</exclude>
                        <exclude>**/*Module.*</exclude>
                        <exclude>**/*Entity.*</exclude>
                        <exclude>**/*Spi.*</exclude>
                        <exclude>**/*Port.*</exclude>
                        <exclude>**/shared/jpa/**</exclude>
                        <exclude>**/shared/events/**</exclude>
                        <exclude>**/*HealthIndicator.*</exclude>
                        <!-- marketplace-shared: data-only records, constants, simple delegators -->
                        <exclude>**/shared/api/*Summary.*</exclude>
                        <exclude>**/shared/api/*Event.*</exclude>
                        <exclude>**/shared/api/SearchCriteria.*</exclude>
                        <exclude>**/shared/api/PaymentIntentDetails.*</exclude>
                        <exclude>**/shared/api/ListingPriceProvider$*</exclude>
                        <exclude>**/shared/api/ApiConstants.*</exclude>
                        <exclude>**/shared/api/BadRequestException.*</exclude>
                        <exclude>**/shared/api/ConflictException.*</exclude>
                        <exclude>**/shared/api/ResourceNotFoundException.*</exclude>
                        <exclude>**/shared/api/ProviderNameResolver.*</exclude>
                        <exclude>**/shared/api/BookingParticipantProvider.*</exclude>
                        <!-- marketplace-platform-infra: data-only config, simple delegators, pure interfaces -->
                        <exclude>**/shared/config/**</exclude>
                        <exclude>**/shared/email/EmailSendException.*</exclude>
                        <exclude>**/shared/security/CurrentUserProvider.*</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.coverage.threshold}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                        <exclude>**/*IntegrationTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                        <include>**/*IntegrationTest.java</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <id>run-integration-tests</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <failOnWarning>true</failOnWarning>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>analyze</id>
                        <goals>
                            <goal>analyze-only</goal>
                        </goals>
                        <configuration>
                            <failOnWarning>false</failOnWarning>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
