    <!-- Release channel: GitHub Packages. The server id "github" matches
         setup-java's server-id in .github/workflows/maven-publish.yml, which
         writes the authenticated server entry (GITHUB_ACTOR / GITHUB_TOKEN)
         into settings.xml at release-build time. Inert for normal builds —
         only `mvn deploy` reads it. Guard-pinned by PlatformGovernanceFilesTest. -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/waelhe/app-java-v3</url>
        </repository>
    </distributionManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-dependency-convergence</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <dependencyConvergence/>
                                <requireUpperBoundDeps/>
                                <banDuplicatePomDependencyVersions/>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                            </rules>
                            <fail>${enforcer.fail}</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <exclude>**/*Application.*</exclude>
                        <exclude>**/*Config.*</exclude>
                        <exclude>**/*Module.*</exclude>
                        <exclude>**/*Entity.*</exclude>
                        <exclude>**/*Spi.*</exclude>
                        <exclude>**/*Port.*</exclude>
                        <exclude>**/shared/jpa/**</exclude>
                        <exclude>**/shared/events/**</exclude>
                        <exclude>**/*HealthIndicator.*</exclude>
                        <!-- marketplace-shared: data-only records, constants, simple delegators -->
                        <exclude>**/shared/api/*Summary.*</exclude>
                        <exclude>**/shared/api/*Event.*</exclude>
                        <!-- L41: the export-entry records (the *ExportPort data
                             shapes — pure carriers, no logic) join the data-only
                             exclusion category the 05bda28 precedent established.
                             Root fix for the class, not the instance: the shared
                             bundle sat at 0.701 measured — one more uncovered
                             record (this layer's CommunityMembershipExportEntry,
                             24 instructions) tipped it to 0.68 and failed the
                             check. Every *ExportEntry record is a carrier by
                             construction (the ports' own javadocs), so the whole
                             category rides the exclusion. -->
                        <exclude>**/shared/api/*ExportEntry.*</exclude>
                        <exclude>**/shared/api/SearchCriteria.*</exclude>
                        <exclude>**/shared/api/PaymentIntentDetails.*</exclude>
                        <exclude>**/shared/api/ListingPriceProvider$*</exclude>
                        <exclude>**/shared/api/ApiConstants.*</exclude>
                        <exclude>**/shared/api/SystemSettingKeys.*</exclude>
                        <exclude>**/shared/api/BadRequestException.*</exclude>
                        <exclude>**/shared/api/ConflictException.*</exclude>
                        <exclude>**/shared/api/ResourceNotFoundException.*</exclude>
                        <exclude>**/shared/api/SystemSettingTypeException.*</exclude>
                        <exclude>**/shared/api/ProviderNameResolver.*</exclude>
                        <exclude>**/shared/api/BookingParticipantProvider.*</exclude>
                        <!-- marketplace-platform-infra: data-only config, simple delegators, pure interfaces -->
                        <exclude>**/shared/config/**</exclude>
                        <exclude>**/shared/email/EmailSendException.*</exclude>
                        <exclude>**/shared/security/CurrentUserProvider.*</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.coverage.threshold}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- JVM locale determinism (Locale.getDefault() is an
                      environment input, not code): -Duser.language/country
                      pin the forked test JVM to en regardless of the OS
                      locale. Without it an ar_EG box lets locale-sensitive
                      library code (JDK ResourceBundle candidates, Stripe
                      SDK String.format HMAC input) diverge from CI. The
                      @{argLine} late-replacement preserves JaCoCo's
                      prepare-agent (official JaCoCo+Surefire pattern). -->
                    <!-- spring.test.context.cache.maxSize: the TestContext
                      framework's own documented knob (Spring Framework
                      reference, Context Caching): the default cache of 32
                      live ApplicationContexts measured ~10GB across this
                      reactor's 122 integration classes on the 16GB CI
                      runner — the kernel's OOM killer then takes dockerd
                      and every Testcontainer dies mid-run (the measured
                      cascade: Redis event loops terminate, PostgreSQL
                      refuses 3800+ connections, Kafka cannot start). The
                      cap bounds the cached-context memory; LRU closes the
                      least recently used context beyond it. -->
                    <argLine>-Duser.language=en -Duser.country=US
                        -Dspring.test.context.cache.maxSize=12 @{argLine}</argLine>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                        <exclude>**/*IntegrationTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <!-- Same JVM locale pin as surefire above: integration
                      tests fork their own JVMs (Stripe webhook signature
                      tests verify HMAC over SDK-formatted bytes). -->
                    <!-- Same context-cache cap as surefire above — the
                      Integration workflow forks the same heavy contexts
                      (the measured dockerd cascade hit BOTH workflows). -->
                    <argLine>-Duser.language=en -Duser.country=US
                        -Dspring.test.context.cache.maxSize=12 @{argLine}</argLine>
                    <includes>
                        <include>**/*IT.java</include>
                        <include>**/*IntegrationTest.java</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <id>run-integration-tests</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <failOnWarning>true</failOnWarning>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>analyze</id>
                        <goals>
                            <goal>analyze-only</goal>
                        </goals>
                        <configuration>
                            <failOnWarning>false</failOnWarning>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
